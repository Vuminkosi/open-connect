@page "/inbox"
@inject IMessagingProfileManager ProfileManager
@inject NavigationManager Navigation

<section aria-label="Inbox" style="max-width: 760px; margin: 0 auto;">
    <h1 style="margin: 0 0 12px 0; font-size: 1.375rem; font-weight: 600;">Inbox</h1>
    @if (ProfileManager.ActiveProfile is null)
    {
        <div role="status" style="padding: 24px 16px; border: 1px dashed var(--oc-mobile-border); border-radius: 8px; text-align: center;">
            <p style="margin: 0 0 8px 0;">No active company profile.</p>
            <MudButton Variant="Variant.Outlined" Style="min-height: 44px;" OnClick="@(() => Navigation.NavigateTo("/scan"))">
                Pair with desktop
            </MudButton>
        </div>
    }
    else
    {
        <MessagingInbox Conversations="@(MessagingProvider?.Conversations)"
                        ConnectionState="@(MessagingProvider?.ConnectionState ?? MessagingConnectionState.Disconnected)"
                        OnSelectConversation="OpenConversation" />
    }
</section>

@code {
    [CascadingParameter(Name = "MessagingProvider")] private MessagingProvider? MessagingProvider { get; set; }

    private void OpenConversation(string id) => Navigation.NavigateTo($"/thread/{id}");
}
