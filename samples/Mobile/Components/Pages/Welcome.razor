@page "/"
@inject IMessagingProfileManager ProfileManager
@inject NavigationManager Navigation

<section aria-label="Welcome to OpenConnect Mobile" style="max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">
    <h1 style="margin: 0; font-size: 1.5rem; font-weight: 600;">OpenConnect Mobile</h1>
    <p style="margin: 0; color: var(--oc-mobile-muted); font-size: 0.9375rem;">
        Connect to any OpenConnect-enabled company gateway by scanning the single-use QR code in your desktop MiniComposer Linked Devices settings.
        No company URLs, agents, or secrets are hardcoded in this application.
    </p>

    <div style="display: flex; flex-wrap: wrap; gap: 12px;">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.QrCodeScanner"
                   Style="min-height: 44px;"
                   OnClick="@(() => Navigation.NavigateTo("/scan"))">
            Scan desktop QR code
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Business"
                   Style="min-height: 44px;"
                   OnClick="@(() => Navigation.NavigateTo("/profiles"))">
            Manage company profiles
        </MudButton>
    </div>

    @if (ProfileManager.ActiveProfile is not null)
    {
        <div role="status" style="padding: 12px 16px; border: 1px solid var(--oc-mobile-border); border-radius: 8px;">
            Active workspace: <strong>@ProfileManager.ActiveProfile.CompanyDisplayName</strong>
            <div style="margin-top: 8px;">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Style="min-height: 44px;" OnClick="@(() => Navigation.NavigateTo("/inbox"))">
                    Open inbox
                </MudButton>
            </div>
        </div>
    }
</section>
