# OpenConnect FW-060 — Content-free structured WAF audit log format
# Intentionally logs normalized $uri (never $args, $request_body, $http_cookie, or $http_authorization).
log_format waf_audit_json escape=json
    '{'
        '"schemaVersion":"openconnect.waf-audit.v1",'
        '"timestamp":"$time_iso8601",'
        '"traceId":"$http_x_correlation_id",'
        '"route":"$uri",'
        '"method":"$request_method",'
        '"status":$status,'
        '"ruleset":"owasp-crs-4.11",'
        '"requestTime":$request_time'
    '}';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    # Enforce strict request and header size limits consistent with OpenConnect boundaries
    client_max_body_size 10m;
    large_client_header_buffers 4 16k;

    access_log /dev/stdout waf_audit_json;

    # Protected demo API route group (upstream reachable ONLY on private oc-test-private network)
    location /api/waf-demo/ {
        limit_except GET POST {
            deny all;
        }
        proxy_pass http://waf-backend:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Correlation-Id $http_x_correlation_id;
        proxy_read_timeout 30s;
    }

    # Blazor Server / SignalR WebSocket circuit preservation
    location /_blazor {
        proxy_pass http://waf-backend:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    location = /health/live {
        add_header Content-Type application/json;
        return 200 '{"status":"live","engine":"owasp-crs-4.11"}';
    }
}
