{
  "fixtureId": "navigator-capture-consent-and-redaction",
  "acceptanceId": "WSE2E-AT-062",
  "withoutConsent": {
    "tool": "capture",
    "args": {
      "url": "https://example.com/index.html",
      "consent": false,
      "text": "Contact alice.tester@example.org or card 4111 1111 1111 1234"
    },
    "expectedStatus": 403,
    "expectedErrorCode": "approval_required"
  },
  "withConsent": {
    "tool": "capture",
    "args": {
      "url": "https://example.com/index.html",
      "consent": true,
      "text": "Contact alice.tester@example.org or card 4111 1111 1111 1234",
      "redactRegions": [
        { "x": 10, "y": 10, "width": 120, "height": 28, "reason": "pii-email" },
        { "x": 10, "y": 44, "width": 160, "height": 28, "reason": "payment-card" }
      ]
    },
    "expectedStatus": 200,
    "expectedRedactedText": "Contact [redacted-email] or card [redacted-card]",
    "forbiddenSubstrings": [
      "alice.tester@example.org",
      "4111 1111 1111 1234"
    ],
    "forbiddenPngChunks": ["tEXt", "iTXt", "zTXt", "eXIf"],
    "forbiddenJpegMarkers": ["APP1_EXIF"]
  }
}
