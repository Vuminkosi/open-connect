# Copy to .env (same directory as the compose file you run) and adjust.
# All values are dummy/test-only. Never commit a real .env with secrets.

# --- harness ---
COMPOSE_PROJECT_NAME=ocw-e2e-local
PROVIDER=local
READY_TIMEOUT_SEC=120
READY_POLL_SEC=2

# --- shared deps ---
NATS_PORT=4222

# --- worker auth (test-only dummy tokens; workers fail closed without them) ---
OPENCONNECT_SCAN_TOKEN=e2e-test-token-do-not-use-in-prod

# --- per-worker ports (host bindings for T2/T3; must not collide) ---
PORT_SECURITY=8080
PORT_CLASSIFICATION=8081
PORT_NLLB=8082
PORT_INFERENCE=8083
PORT_TRANSCRIPTION=8084
PORT_REALTIME_VOICE=8085
PORT_KOKORO=8086
PORT_MMS_TTS=8087
PORT_NAVIGATOR_PLAYWRIGHT=8088
PORT_OPERATIONAL_AGENTS=8089
PORT_OUTBOX=8090

# --- T4 model-live (BLOCKED: no approved assets; leave unset) ---
# MODEL_DIR=
# HF_TOKEN=

# --- OpenConnect worker/model defaults (workers-model-defaults contract) ---
# Canonical OC_* names are primary config. Legacy names (OPENCONNECT_FAKE_ENGINE,
# MODEL_DIR, INFERENCE_CLOUD_URL, TRANSCRIPTION_CLOUD_URL, INFERENCE_MODEL_ID,
# TRANSCRIPTION_MODEL_ID) still work as deprecated aliases; OC_ wins when both
# are set. All values below are placeholders/dummy-only. Never commit real
# credentials; API keys are injected by the host secret manager at deploy time.

# Execution mode: real (default) | fake. Fake is for controlled CI/test only
# and is rejected in production (OPENCONNECT_ENV=production).
OC_WORKER_ENGINE=real
# OPENCONNECT_FAKE_ENGINE=0

# Device selection: cpu | cuda | auto (default).
OC_MODEL_DEVICE=auto

# Model provisioning: disabled | verify-existing-only | first-start-if-missing
# (default). Today no worker downloads weights: informational until a
# provisioner lands. "disabled" never provisions; missing assets => unready.
OC_MODEL_PROVISIONING=first-start-if-missing

# Local model cache directory (default /models). Exposed in /health/ready.
OC_MODEL_CACHE_DIR=/models
# MODEL_DIR=/models

# --- inference (cloud: Meta Model API; local fallback stays explicit) ---
OC_INFERENCE_PROVIDER=meta-model-api
OC_INFERENCE_MODEL=muse-spark-1.3-contributor
OC_INFERENCE_API_BASE_URL=https://api.meta.ai/v1
# INFERENCE_CLOUD_URL=
# Runtime secret injection (never commit a real value):
# INFERENCE_CLOUD_API_KEY=

# Contributor-tier approval: Meta states contributor-mode prompts/outputs may
# be used to train future models. Explicit operator approval is required:
# OC_CONTRIBUTOR_DATA_USE_APPROVED must be exactly 1, else the inference
# worker fails closed (startup + execute, 503 contributor_approval_required).
OC_CONTRIBUTOR_DATA_USE_APPROVED=0

# --- transcription (cloud: Meta Muse Voice Transcribe) ---
OC_TRANSCRIPTION_PROVIDER=meta-model-api
# Wire mode: ENDPOINTING (dialogue-style, default) | PUSH_TO_TALK | DIARIZATION.
OC_TRANSCRIPTION_MODE=ENDPOINTING
OC_TRANSCRIPTION_REALTIME_URL=wss://api.meta.ai/v1/asr/realtime
OC_TRANSCRIPTION_FILE_URL=https://api.meta.ai/v1/asr/transcribe
# TRANSCRIPTION_CLOUD_URL=
# Exact provider model ID; default EMPTY (never guessed). Missing => the
# transcription cloud path stays unready until the operator sets it.
OC_TRANSCRIPTION_MODEL=
# Runtime secret injection (never commit a real value):
# TRANSCRIPTION_CLOUD_API_KEY=
