  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenConnect.Samples.Workers.Contracts\OpenConnect.Samples.Workers.Contracts.csproj" />
    <ProjectReference Include="..\OpenConnect.Samples.Workers.Host\OpenConnect.Samples.Workers.Host.csproj" />
    <ProjectReference Include="..\..\..\persistence\postgres\OpenConnect.Samples.Persistence.Postgres.csproj" />
    <ProjectReference Include="..\..\..\persistence\sqlserver\OpenConnect.Samples.Persistence.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\persistence\sqlite\OpenConnect.Samples.Persistence.Sqlite.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>
</Project>
