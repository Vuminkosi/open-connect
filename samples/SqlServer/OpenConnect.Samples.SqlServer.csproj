<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OpenConnect.Samples.SqlServer</AssemblyName>
    <!-- Samples are never shippable NuGet packages (OC-G5-FIX01). -->
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenConnect.Samples.SqlServer</RootNamespace>
    <!-- Design package supports `dotnet ef migrations list` from this sample's own pipeline. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenConnect.Persistence.EFCore\OpenConnect.Persistence.EFCore.csproj" />
    <ProjectReference Include="..\_shared\OpenConnect.Samples.Shared\OpenConnect.Samples.Shared.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>
</Project>
