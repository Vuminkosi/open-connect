<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>OpenConnect.Samples.Blazor</AssemblyName>
    <!-- Samples are never shippable NuGet packages (OC-G5-FIX01). -->
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenConnect.Samples.Blazor</RootNamespace>
    <!-- Design package supports `dotnet ef migrations add` from this sample's own pipeline. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenConnect.Persistence.EFCore\OpenConnect.Persistence.EFCore.csproj" />
    <ProjectReference Include="..\_shared\OpenConnect.Samples.Shared\OpenConnect.Samples.Shared.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>
</Project>
