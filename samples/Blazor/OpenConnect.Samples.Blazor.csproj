<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>OpenConnect.Samples.Blazor</AssemblyName>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenConnect.Samples.Blazor</RootNamespace>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- dotnet format does not run the Razor generator. Its explicit preparation
         build uses the SDK's physical generation pipeline; normal builds and
         IDE workspaces retain the default source generator. -->
    <UseRazorSourceGenerator Condition="'$(OpenConnectFormatWorkspace)' == 'true'">false</UseRazorSourceGenerator>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenConnect.Abstractions\OpenConnect.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Core\OpenConnect.Core.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Documents\OpenConnect.Documents.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Knowledge\OpenConnect.Knowledge.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Agents\OpenConnect.Agents.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Tools\OpenConnect.Tools.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.IMessaging\OpenConnect.IMessaging.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Client\OpenConnect.Client.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Components.Contracts\OpenConnect.Components.Contracts.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Components.Blazor\OpenConnect.Components.Blazor.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.Hosting.AspNetCore\OpenConnect.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.LiveUI.Blazor\OpenConnect.LiveUI.Blazor.csproj" />
    <ProjectReference Include="..\..\src\OpenConnect.LiveUI.Compiler\OpenConnect.LiveUI.Compiler.csproj" ReferenceOutputAssembly="false" OutputItemType="OpenConnectLiveUICompiler" />
    <ProjectReference Include="..\..\src\OpenConnect.Persistence.EFCore\OpenConnect.Persistence.EFCore.csproj" />
    <ProjectReference Include="..\_shared\OpenConnect.Samples.Shared\OpenConnect.Samples.Shared.csproj" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\workers\shared\OpenConnect.Samples.Workers.Host\OpenConnect.Samples.Workers.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)openconnect.liveui.manifest.json"
                      LogicalName="$(AssemblyName).openconnect.liveui.manifest.json" />
  </ItemGroup>
  <Target Name="GenerateOpenConnectLiveUIManifest" BeforeTargets="PrepareResourceNames" DependsOnTargets="ResolveProjectReferences">
    <Error Condition="'@(OpenConnectLiveUICompiler)' == ''" Text="The LiveUI compiler project output could not be resolved." />
    <Exec Command="dotnet &quot;@(OpenConnectLiveUICompiler)&quot; --root &quot;$(MSBuildProjectDirectory)&quot; --output &quot;$(IntermediateOutputPath)openconnect.liveui.manifest.json&quot;" />
  </Target>
  <Target Name="CleanRazorFormattingOutputs"
          BeforeTargets="RazorGenerateComponentDeclaration"
          Condition="'$(OpenConnectFormatWorkspace)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <!-- Only disposable compiler outputs for this sample; force fresh generation. -->
    <RemoveDir Directories="$(RazorGenerateIntermediateOutputPath);$(_RazorComponentDeclarationOutputPath)" />
    <Delete Files="$(_RazorComponentDeclarationOutputCacheFile)" />
  </Target>
  <Target Name="IncludePreparedRazorForFormatting"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveRazorComponentInputs;AssignRazorComponentTargetPaths;_ResolveRazorComponentOutputs"
          Condition="'$(OpenConnectFormatWorkspace)' == 'true' and '$(DesignTimeBuild)' == 'true'">
    <Error Condition="'@(_RazorComponentDefinition)' == ''"
           Text="No Razor component outputs were resolved for the formatting workspace." />
    <Error Condition="!Exists('%(_RazorComponentDefinition.Identity)')"
           Text="Build this sample with OpenConnectFormatWorkspace=true before formatting; generated Razor component is missing: %(_RazorComponentDefinition.Identity)" />
    <ItemGroup>
      <Compile Include="@(_RazorComponentDefinition)" />
    </ItemGroup>
  </Target>
</Project>
