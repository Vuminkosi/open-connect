@page "/"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using OpenConnect.Abstractions
@inject BlazorDbContext Db
@inject IServiceProvider ServiceProvider
@inject ILogger<Home> Logger

<PageTitle>Work overview</PageTitle>

<h1 class="page-heading">What needs attention?</h1>
<p class="page-lede">Pending deliveries, session history, and the health of the local store — grouped by what you came to do.</p>

<div class="status-region" role="status" aria-live="polite">
    @if (!string.IsNullOrEmpty(_notice))
    {
        <p>@_notice</p>
    }
    else if (_loading)
    {
        <p>Checking the local store…</p>
    }
</div>

<div class="job-grid">
    <section class="job-card" aria-labelledby="queue-heading">
        <h2 id="queue-heading">Deliveries waiting</h2>
        <p class="job-hint">Items recorded locally that still need to go out. Confirm one when it has been handled.</p>
        @if (_queueLoading)
        {
            <p class="muted">Loading the queue…</p>
        }
        else if (_queueUnavailable)
        {
            <p class="muted">The queue is unavailable in this build. Check again in a moment.</p>
        }
        else if (_queue.Count == 0)
        {
            <p class="empty">Nothing waiting — the queue is clear.</p>
        }
        else
        {
            <ul class="queue-list">
                @foreach (var entry in _queue)
                {
                    <li class="queue-item">
                        <div class="queue-item-text">
                            <p class="queue-type" title="@Humanize(entry.Type)">@Humanize(entry.Type)</p>
                            <p class="queue-ref" title="Reference @ShortId(entry.Id)">Reference @ShortId(entry.Id)</p>
                        </div>
                        <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="() => ConfirmDeliveredAsync(entry.Id)">
                            Confirm handled
                        </button>
                    </li>
                }
            </ul>
        }
        <button type="button" class="btn btn-ghost" disabled="@(_busy || _queueLoading)" @onclick="RefreshQueueAsync">
            Check again
        </button>
    </section>

    <section class="job-card" aria-labelledby="history-heading">
        <h2 id="history-heading">Session history</h2>
        <p class="job-hint">Replay what happened in a session, oldest first. Paste the session reference from your records.</p>
        <form @onsubmit="LoadHistoryAsync" @onsubmit:preventDefault="true">
            <label class="field-label" for="session-input">Session reference</label>
            <input id="session-input" class="field-input" @bind="_sessionInput" @bind:event="oninput"
                   placeholder="e.g. 01J…" autocomplete="off" spellcheck="false"
                   aria-invalid="@(!string.IsNullOrEmpty(_sessionError) ? "true" : null)"
                   aria-describedby="@(!string.IsNullOrEmpty(_sessionError) ? "session-input-error" : null)" />
            @if (!string.IsNullOrEmpty(_sessionError))
            {
                <p class="field-error" id="session-input-error" role="alert">@_sessionError</p>
            }
            <button type="submit" class="btn btn-primary" disabled="@_busy">Show history</button>
        </form>
        @if (_historyLoading)
        {
            <p class="muted">Replaying…</p>
        }
        else if (_history is not null && _history.Count == 0)
        {
            <p class="empty">No recorded steps for that reference.</p>
        }
        else if (_history is not null)
        {
            <ol class="history-list">
                @foreach (var record in _history)
                {
                    <li class="history-item">
                        <span class="history-seq" aria-hidden="true">@record.Sequence</span>
                        <div>
                            <p class="queue-type">@Humanize(record.Type)</p>
                            <p class="history-data">Step @record.Sequence of this session — recorded as @Humanize(record.Type).</p>
                        </div>
                    </li>
                }
            </ol>
        }
    </section>

    <section class="job-card" aria-labelledby="store-heading">
        <h2 id="store-heading">Local store health</h2>
        @if (_storeLoading)
        {
            <p class="muted">Checking…</p>
        }
        else if (!_reachable)
        {
            <p class="empty">The local store isn't reachable. Start the sample with its database file available, then check again.</p>
        }
        else
        {
            <dl class="health-list">
                <div>
                    <dt>Status</dt>
                    <dd>@(_pendingCount == 0 ? "Ready" : $"{_pendingCount} update(s) outstanding")</dd>
                </div>
                <div>
                    <dt>Stored record types</dt>
                    <dd>@_tableCount</dd>
                </div>
                <div>
                    <dt>Applied updates</dt>
                    <dd>@_appliedCount</dd>
                </div>
            </dl>
            @if (_pendingCount > 0)
            {
                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="ApplyUpdatesAsync">
                    Apply pending updates
                </button>
            }
        }
        <button type="button" class="btn btn-ghost" disabled="@(_busy || _storeLoading)" @onclick="RefreshStoreAsync">
            Check again
        </button>
    </section>
</div>

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _notice;
    private bool _queueLoading = true;
    private bool _queueUnavailable;
    private List<OutboxEntry> _queue = new();
    private string _sessionInput = string.Empty;
    private string? _sessionError;
    private List<EventRecord>? _history;
    private bool _historyLoading;
    private bool _storeLoading = true;
    private bool _reachable;
    private int _tableCount;
    private int _appliedCount;
    private int _pendingCount;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await RefreshStoreAsync().ConfigureAwait(false);
        await RefreshQueueAsync().ConfigureAwait(false);
        _loading = false;
    }

    private IOutboxStore? Outbox => ServiceProvider.GetService<IOutboxStore>();

    private IEventJournal? Journal => ServiceProvider.GetService<IEventJournal>();

    private async Task RefreshStoreAsync()
    {
        _storeLoading = true;
        _notice = null;
        try
        {
            _reachable = await Db.Database.CanConnectAsync().ConfigureAwait(false);
            if (_reachable)
            {
                _tableCount = Db.Model.GetEntityTypes().Count(t => !string.IsNullOrEmpty(t.GetTableName()));
                var applied = await Db.Database.GetAppliedMigrationsAsync().ConfigureAwait(false);
                var pending = await Db.Database.GetPendingMigrationsAsync().ConfigureAwait(false);
                _appliedCount = applied.Count();
                _pendingCount = pending.Count();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "blazor_sample_store_check_failed");
            _reachable = false;
            _notice = "Couldn't reach the local store. Check again in a moment.";
        }
        finally
        {
            _storeLoading = false;
        }
    }

    private async Task ApplyUpdatesAsync()
    {
        _busy = true;
        _notice = null;
        try
        {
            await Db.Database.MigrateAsync().ConfigureAwait(false);
            await RefreshStoreAsync().ConfigureAwait(false);
            _notice = _pendingCount == 0 ? "Store is up to date." : "Updates applied. Review what remains above.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "blazor_sample_migrate_failed");
            _notice = "Couldn't apply the updates. Check again in a moment.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshQueueAsync()
    {
        _queueLoading = true;
        try
        {
            var outbox = Outbox;
            if (outbox is null)
            {
                _queueUnavailable = true;
                return;
            }

            _queueUnavailable = false;
            _queue = (await outbox.GetPendingAsync(50).ConfigureAwait(false)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "blazor_sample_queue_check_failed");
            _notice = "Couldn't load the queue. Check again in a moment.";
        }
        finally
        {
            _queueLoading = false;
        }
    }

    private async Task ConfirmDeliveredAsync(Guid entryId)
    {
        var outbox = Outbox;
        if (outbox is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await outbox.MarkDeliveredAsync(entryId).ConfigureAwait(false);
            await RefreshQueueAsync().ConfigureAwait(false);
            _notice = "Marked as handled and removed from the queue.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "blazor_sample_confirm_failed");
            _notice = "Couldn't confirm that item. Check again in a moment.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        _sessionError = null;
        _history = null;
        var input = _sessionInput.Trim();
        if (string.IsNullOrEmpty(input))
        {
            _sessionError = "Enter a session reference first.";
            return;
        }

        SessionId sessionId;
        try
        {
            sessionId = new SessionId(Ulid.Parse(input));
        }
        catch (Exception)
        {
            _sessionError = "That reference doesn't look right. Check it and try again.";
            return;
        }

        var journal = Journal;
        if (journal is null)
        {
            _sessionError = "History lookup is unavailable in this build.";
            return;
        }

        _busy = true;
        _historyLoading = true;
        try
        {
            var records = new List<EventRecord>();
            await foreach (var record in journal.ReplayAsync(sessionId).ConfigureAwait(false))
            {
                records.Add(record);
                if (records.Count >= 200)
                {
                    break;
                }
            }

            _history = records;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "blazor_sample_history_failed");
            _sessionError = "Couldn't load that history. Check the reference and try again.";
        }
        finally
        {
            _historyLoading = false;
            _busy = false;
        }
    }

    private static string Humanize(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Unlabeled item";
        }

        return value.Replace('.', ' ').Replace('_', ' ').Replace('-', ' ').Trim();
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8];
}
