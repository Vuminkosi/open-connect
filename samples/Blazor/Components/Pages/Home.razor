@page "/"
@rendermode InteractiveServer

<PageTitle>OpenConnect - Todo Application</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Task Management</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary">
        Manage everyday tasks, organize milestones, or let the AI Agent assist you via the OpenConnect Composer.
    </MudText>
</div>

<TodoProgressComponent @ref="_progressRef" />

<TodoEditorComponent OnTaskCreated="@OnTaskCreatedAsync" />

<TodoListComponent @ref="_todoListRef" />

@code {
    private TodoProgressComponent? _progressRef;
    private TodoListComponent? _todoListRef;

    private async Task OnTaskCreatedAsync()
    {
        if (_progressRef != null)
        {
            await _progressRef.RefreshProgressAsync();
        }
        if (_todoListRef != null)
        {
            await _todoListRef.LoadItemsAsync();
        }
    }
}
