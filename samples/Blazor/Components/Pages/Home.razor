@page "/"
@rendermode InteractiveServer

<PageTitle>OpenConnect - Todo Application</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Task Management</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary">
        Manage everyday tasks, organize milestones, or let the AI Agent assist you via the OpenConnect Composer.
    </MudText>
</div>

<TodoProgressComponent @ref="_progressRef" />

<TodoEditorComponent OnTaskCreated="@OnTaskCreatedAsync" />
<MudButton @ref="_dialogButton" Variant="Variant.Outlined" Class="mb-4" OnClick="OpenCreateDialog">New task dialog</MudButton>
@if (_showCreateDialog)
{
    <TodoCreateDialog OnCreated="DialogCreatedAsync" OnCancel="CloseCreateDialog" />
}

<TodoListComponent @ref="_todoListRef" />

@code {
    private TodoProgressComponent? _progressRef;
    private TodoListComponent? _todoListRef;
    private MudButton? _dialogButton;
    private bool _showCreateDialog;
    private bool _restoreDialogFocus;

    private void OpenCreateDialog() => _showCreateDialog = true;

    private void CloseCreateDialog()
    {
        _showCreateDialog = false;
        _restoreDialogFocus = true;
    }

    private async Task DialogCreatedAsync()
    {
        CloseCreateDialog();
        await OnTaskCreatedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreDialogFocus && _dialogButton is not null)
        {
            _restoreDialogFocus = false;
            await _dialogButton.FocusAsync();
        }
    }

    private async Task OnTaskCreatedAsync()
    {
        if (_progressRef != null)
        {
            await _progressRef.RefreshProgressAsync();
        }
        if (_todoListRef != null)
        {
            await _todoListRef.LoadItemsAsync();
        }
    }
}
