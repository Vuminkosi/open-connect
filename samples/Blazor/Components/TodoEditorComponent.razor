@using OpenConnect.Samples.Blazor.Models
@inject ITodoStore Store
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="oc-surface-card pa-5 mb-6">
    <div class="d-flex align-center mb-4">
        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="mr-2">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
        </MudAvatar>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Create New Task</MudText>
    </div>

    <MudGrid Spacing="2">
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_title"
                          Label="Task Title"
                          Placeholder="e.g., Integrate Playwright navigator worker"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          Clearable="true" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_priority"
                       Label="Priority"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       T="TodoPriority"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="TodoPriority.Low">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Default" Size="Size.Small" Class="mr-2" />
                        <span>Low</span>
                    </div>
                </MudSelectItem>
                <MudSelectItem Value="TodoPriority.Medium">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Info" Size="Size.Small" Class="mr-2" />
                        <span>Medium</span>
                    </div>
                </MudSelectItem>
                <MudSelectItem Value="TodoPriority.High">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                        <span>High</span>
                    </div>
                </MudSelectItem>
                <MudSelectItem Value="TodoPriority.Urgent">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                        <span>Urgent</span>
                    </div>
                </MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@CreateTaskAsync"
                       Disabled="@string.IsNullOrWhiteSpace(_title)"
                       FullWidth="true"
                       Size="Size.Medium"
                       Class="rounded-lg py-2">
                Add Task
            </MudButton>
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_description"
                          Label="Details & Context (Optional)"
                          Placeholder="Describe acceptance criteria or agent orchestration steps..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2" />
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public EventCallback OnTaskCreated { get; set; }

    private string _title = string.Empty;
    private string? _description;
    private TodoPriority _priority = TodoPriority.Medium;

    private async Task CreateTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_title)) return;

        await Store.AddAsync(_title.Trim(), _description?.Trim(), _priority);
        _title = string.Empty;
        _description = null;
        _priority = TodoPriority.Medium;

        Snackbar.Add("Task created successfully", Severity.Success);
        if (OnTaskCreated.HasDelegate)
        {
            await OnTaskCreated.InvokeAsync();
        }
    }
}
