@using OpenConnect.Samples.Blazor.Models
@inject ITodoStore Store
@inject IServiceProvider Services
@inject IHostEnvironment HostEnvironment
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="oc-surface-card pa-5 mb-6" data-oc-target="todo-editor">
    <div class="d-flex align-center mb-4">
        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="mr-2">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-hidden="true" />
        </MudAvatar>
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Create New Task</MudText>
    </div>

    <MudGrid Spacing="2">
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_title"
                          @bind-Value:after="ClearTitleError"
                          Label="Task Title"
                          Placeholder="e.g., Integrate Playwright navigator worker"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          MaxLength="200"
                          Error="@(_titleError is not null)"
                          ErrorText="@_titleError"
                          Required="true"
                          Clearable="true" />
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_priority"
                       Label="Priority"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       T="TodoPriority"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="TodoPriority.Low">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Default" Size="Size.Small" Class="mr-2" />
                        <span>Low</span>
                    </div>
                </MudSelectItem>
                <MudSelectItem Value="TodoPriority.Medium">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Info" Size="Size.Small" Class="mr-2" />
                        <span>Medium</span>
                    </div>
                </MudSelectItem>
                <MudSelectItem Value="TodoPriority.High">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                        <span>High</span>
                    </div>
                </MudSelectItem>
                <MudSelectItem Value="TodoPriority.Urgent">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                        <span>Urgent</span>
                    </div>
                </MudSelectItem>
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@CreateTaskAsync"
                       Disabled="@_creating"
                       FullWidth="true"
                       Size="Size.Medium"
                       Class="rounded-lg py-2 oc-touch-target">
                Add Task
            </MudButton>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <label for="oc-editor-due-date" class="d-block mb-1" style="font-size: 0.75rem; color: var(--mud-palette-text-secondary);">Due date (optional)</label>
            <input id="oc-editor-due-date" class="oc-native-input w-100" type="date" @bind="_dueDate" />
        </MudItem>

        @if (HostEnvironment.IsDevelopment())
        {
            <MudItem xs="12" sm="6" md="4">
                <label for="oc-editor-assignee" class="d-block mb-1" style="font-size: 0.75rem; color: var(--mud-palette-text-secondary);">Assignee (optional)</label>
                <select id="oc-editor-assignee" class="oc-native-select w-100" @bind="_assigneeKey">
                    <option value="">Unassigned (local workspace)</option>
                    @foreach (var person in AvailableAssignees)
                    {
                        <option value="@person.Key">@person.DisplayName</option>
                    }
                </select>
            </MudItem>

            <MudItem xs="12" md="4">
                <label for="oc-editor-escalation" class="d-block mb-1" style="font-size: 0.75rem; color: var(--mud-palette-text-secondary);">Escalation policy (optional)</label>
                <input id="oc-editor-escalation"
                       class="oc-native-input w-100"
                       maxlength="120"
                       placeholder="e.g., escalate:supervisor:15m"
                       @bind="_escalationPolicy" />
            </MudItem>
        }

        <MudItem xs="12">
            <MudTextField @bind-Value="_description"
                          Label="Details & Context (Optional)"
                          Placeholder="Describe acceptance criteria or agent orchestration steps..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2" />
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public EventCallback OnTaskCreated { get; set; }

    private string _title = string.Empty;
    private string? _titleError;
    private bool _creating;
    private string? _description;
    private TodoPriority _priority = TodoPriority.Medium;
    private DateTime? _dueDate;
    private string _assigneeKey = string.Empty;
    private string? _escalationPolicy;

    private IEnumerable<SeedPrincipal> AvailableAssignees
    {
        get
        {
            var persona = Services.GetService<TodoDevelopmentPersonaState>()?.Current;
            return persona is null
                ? TodoDirectorySeed.Principals
                : TodoDirectorySeed.Principals.Where(p => p.TenantId == persona.TenantId);
        }
    }

    private async Task CreateTaskAsync()
    {
        if (_creating) return;
        if (string.IsNullOrWhiteSpace(_title))
        {
            _titleError = "Enter a task title.";
            return;
        }

        _creating = true;
        try
        {
            var dueDateUtc = _dueDate is null ? (DateTime?)null : DateTime.SpecifyKind(_dueDate.Value.Date, DateTimeKind.Local).ToUniversalTime();
            var selectedAssignee = TodoDirectorySeed.FindByKey(_assigneeKey);
            if (selectedAssignee is not null && Services.GetService<SqliteTodoStore>() is { } sqliteStore)
            {
                var persona = Services.GetService<TodoDevelopmentPersonaState>()?.Current;
                await sqliteStore.AddOperationalTaskAsync(
                    selectedAssignee.TenantId,
                    _title.Trim(),
                    _description?.Trim(),
                    _priority,
                    dueDateUtc,
                    selectedAssignee.PrincipalId,
                    string.IsNullOrWhiteSpace(_escalationPolicy) ? null : _escalationPolicy.Trim(),
                    persona?.Key ?? "desktop-user");
            }
            else
            {
                await Store.AddAsync(_title.Trim(), _description?.Trim(), _priority, dueDateUtc);
            }

            _title = string.Empty;
            _description = null;
            _priority = TodoPriority.Medium;
            _dueDate = null;
            _assigneeKey = string.Empty;
            _escalationPolicy = null;

            Snackbar.Add("Task created successfully", Severity.Success);
            if (OnTaskCreated.HasDelegate)
            {
                await OnTaskCreated.InvokeAsync();
            }
        }
        finally { _creating = false; }
    }

    private void ClearTitleError() => _titleError = null;
}
