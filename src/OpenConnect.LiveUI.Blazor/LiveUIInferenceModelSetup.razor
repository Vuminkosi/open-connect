@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using OpenConnect.LiveUI.Inference
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IOptions<LiveUIInferenceOptions> InferenceOptions
@inject BrowserPromptApiInferenceProvider BrowserProvider

@if (_checked && ShouldShow)
{
    <div class="oc-liveui-model-setup" aria-live="polite" aria-atomic="true">
        @if (_availability?.Status is LiveUIInferenceAvailabilityStatus.Downloadable or LiveUIInferenceAvailabilityStatus.Downloading)
        {
            <button @ref="_setupButton" type="button" class="oc-liveui-model-setup__button"
                    disabled="@(_availability.Status == LiveUIInferenceAvailabilityStatus.Downloading)">
                @(_availability.Status == LiveUIInferenceAvailabilityStatus.Downloading ? "Preparing on-device AI…" : "Enable on-device AI")
            </button>
            @if (_availability.Status == LiveUIInferenceAvailabilityStatus.Downloading && _downloadPercent is double percent)
            {
                <progress class="oc-liveui-model-setup__progress" value="@percent" max="100" aria-label="On-device model download progress"></progress>
                <span class="oc-liveui-model-setup__percent">@percent.ToString("0")%</span>
            }
        }
        else if (_availability?.Status == LiveUIInferenceAvailabilityStatus.Available)
        {
            <span class="oc-liveui-model-setup__status">On-device AI ready</span>
        }
        else if (!string.IsNullOrWhiteSpace(_message))
        {
            <button @ref="_setupButton" type="button" class="oc-liveui-model-setup__button">
                Try on-device AI again
            </button>
            <span class="oc-liveui-model-setup__status" role="status">@_message</span>
        }
    </div>
}

@code {
    private const string ModulePath = "./_content/OpenConnect.LiveUI.Blazor/liveui-inference.js";
    private ElementReference _setupButton;
    private IJSObjectReference? _module;
    private DotNetObjectReference<LiveUIInferenceModelSetup>? _dotNetReference;
    private LiveUIInferenceAvailability? _availability;
    private bool _checked;
    private bool _buttonBound;
    private bool _disposed;
    private double? _downloadPercent;
    private string? _message;

    private bool ShouldShow => _availability?.Status is LiveUIInferenceAvailabilityStatus.Available
        or LiveUIInferenceAvailabilityStatus.Downloadable
        or LiveUIInferenceAvailabilityStatus.Downloading || !string.IsNullOrWhiteSpace(_message);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        if (firstRender)
        {
            try
            {
                _availability = await BrowserProvider.GetAvailabilityAsync();
            }
            catch (JSDisconnectedException)
            {
                _availability = new(LiveUIInferenceProviderKind.Browser,
                    LiveUIInferenceAvailabilityStatus.Unavailable, Reason: "browser_disconnected");
            }
            _checked = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!_buttonBound && (_availability?.Status == LiveUIInferenceAvailabilityStatus.Downloadable ||
            !string.IsNullOrWhiteSpace(_message)))
        {
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
                _dotNetReference ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("bindUserGestureInitializer", _setupButton, _dotNetReference,
                    InferenceOptions.Value.Browser.Provider.ToString());
                _buttonBound = true;
            }
            catch (JSDisconnectedException)
            {
                _message = "On-device AI setup is unavailable while the browser is disconnected.";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    [JSInvokable]
    public Task OnModelInitializationStarted()
    {
        _message = null;
        _availability = new(LiveUIInferenceProviderKind.Browser, LiveUIInferenceAvailabilityStatus.Downloading);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnModelDownloadProgress(long loaded, long total)
    {
        if (loaded < 0 || total <= 0) return Task.CompletedTask;
        _downloadPercent = Math.Clamp(loaded * 100d / total, 0, 100);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnModelInitializationCompleted(LiveUIInferenceAvailability availability)
    {
        _availability = availability;
        _downloadPercent = null;
        _message = availability.Status == LiveUIInferenceAvailabilityStatus.Available
            ? null
            : "On-device AI could not be prepared. LiveUI will use the configured server fallback.";
        _buttonBound = false;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("unbindUserGestureInitializer", _setupButton); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _dotNetReference?.Dispose();
    }
}
