@using OpenConnect.Components.Contracts
@*
  MiniComposer: anchored floating-assistant composer matching the production UI spec.

  Closed  = FAB only (fixed at bottom right, 85vh from top, z-index: 99999).
  Open    = floating card anchored above the FAB with drag handle, controls, audio waveform, and voice/mic toggles.
  Attached (Placement == Attached) = inline bubble only: no FAB, no drag.

  Host requirements:
  MudThemeProvider, MudPopoverProvider, MudDialogProvider, MudSnackbarProvider.
*@
<div class="oc-anchored-host @(IsAttached ? "oc-attached" : "")">
    @if (ShowFab)
    {
        <MudFab StartIcon="@FabIcon"
                Color="Color.Default"
                Size="Size.Large"
                aria-label="@(_open ? $"Close {AssistantName}" : $"Open {AssistantName}")"
                aria-expanded="@_open"
                OnClick="@Toggle"
                Class="@($"oc-anchored-fab {FabClass}")"
                Style="@FabStyle" />
    }

    @if (_open || IsAttached)
    {
        <section @ref="_panelRef"
                 class="oc-bubble"
                 role="dialog"
                 aria-modal="false"
                 aria-label="@($"{AssistantName} composer")">
            <!-- Top Row / Header: Drag Handle on Left | Settings, Red Stop, Close on Right -->
            <header class="oc-bubble-header">
                @if (!IsAttached)
                {
                    <button @ref="_handleRef"
                            type="button"
                            class="oc-drag-handle"
                            aria-label="Move assistant panel"
                            title="Drag to move">
                        <span aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.OpenWith" Size="Size.Small" /></span>
                    </button>
                }
                else
                {
                    <div style="width: 28px;"></div>
                }
                <!-- Accessible/contract titles for test & screen readers -->
                <span class="oc-bubble-title" style="display: none;">@AssistantName</span>
                <span class="oc-bubble-subtitle" style="display: none;">@StatusText</span>

                <div class="oc-bubble-header-actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                   aria-label="Composer settings"
                                   Size="Size.Small"
                                   Class="oc-header-icon-btn"
                                   OnClick="@(() => _showSettings = !_showSettings)" />
                    <button type="button"
                            class="oc-header-red-stop"
                            aria-label="Stop reply"
                            title="Stop reply"
                            @onclick="StopSending">
                        <span class="oc-stop-sq"></span>
                    </button>
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   aria-label="@CloseLabel"
                                   Size="Size.Small"
                                   Class="oc-header-icon-btn"
                                   OnClick="@Close" />
                </div>
            </header>

            @if (IsLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="oc-bubble-progress" aria-label="Waiting for reply" />
            }

            <!-- Subheading: Message AssistantName -->
            <div class="oc-assistant-row">
                <span class="oc-assistant-text">Message @AssistantName</span>
            </div>

            <!-- Messages Area (when messages or streaming text exist) -->
            @if (VisibleMessages.Count > 0 || !string.IsNullOrEmpty(Session?.StreamingText) || (Session?.Proposals.Count > 0))
            {
                <div class="oc-bubble-messages" role="log" aria-live="polite" aria-label="Conversation">
                    @foreach (var message in VisibleMessages)
                    {
                        <div class="oc-message @(message.Role == "user" ? "oc-message-user" : "oc-message-assistant")">
                            <span class="oc-message-role">@(message.Role == "user" ? "You" : AssistantName)</span>
                            <p class="oc-message-text">@message.Text</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Session?.StreamingText))
                    {
                        <div class="oc-message oc-message-assistant oc-message-streaming">
                            <span class="oc-message-role">@AssistantName</span>
                            <p class="oc-message-text">@Session.StreamingText</p>
                        </div>
                    }
                    @if (Session?.Proposals is not null)
                    {
                        @foreach (var proposal in Session.Proposals)
                        {
                            <SafeComponentRenderer Proposal="proposal" />
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Session?.LastError))
            {
                <div class="oc-bubble-error" role="alert">
                    <span>@Session.LastError</span>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@Retry">Retry</MudButton>
                </div>
            }

            @if (Suggestions?.Count > 0 && !IsLoading)
            {
                <div class="oc-bubble-chips" aria-label="Suggestions">
                    @foreach (var suggestion in Suggestions)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => UseSuggestion(suggestion))">@suggestion</MudChip>
                    }
                </div>
            }

            <!-- Input Row: Textarea + Red Stop/Send Circle + Waveform Icon -->
            <div class="oc-bubble-input-row">
                <textarea @ref="_inputRef"
                          id="@_editorId"
                          class="oc-editor-input"
                          rows="1"
                          maxlength="@MaxInputLength"
                          placeholder="@Placeholder"
                          aria-label="@($"Message {AssistantName}")"
                          disabled="@(!CanType)"
                          @bind="_draft"
                          @bind:event="oninput"
                          @oninput="HandleInput"
                          @onkeydown="HandleKeyDown"></textarea>
                <div class="oc-input-actions">
                    <button type="button"
                            class="oc-input-red-stop"
                            aria-label="@(IsLoading ? "Stop reply" : "Send message")"
                            title="@(IsLoading ? "Stop reply" : "Send message")"
                            disabled="@(!IsLoading && !CanSend)"
                            @onclick="@(IsLoading ? StopSending : SendAsync)">
                        <span class="oc-stop-sq"></span>
                    </button>
                    <button type="button"
                            class="oc-waveform-btn"
                            aria-label="Voice input"
                            title="Voice input"
                            @onclick="@(() => _micOn = !_micOn)">
                        <MudIcon Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" />
                    </button>
                </div>
            </div>

            <!-- Dotted Divider -->
            <div class="oc-bubble-divider"></div>

            <!-- Footer: ••• Ready on left | Voice on & Mic on on right -->
            <footer class="oc-bubble-footer">
                <div class="oc-footer-ready">
                    <span class="oc-dots-indicator">•••</span>
                    <span class="oc-ready-text">@StatusText</span>
                </div>
                <div class="oc-footer-toggles">
                    <button type="button"
                            class="oc-footer-toggle-btn @(_speechOn ? "is-active" : "")"
                            @onclick="@(() => _speechOn = !_speechOn)"
                            aria-label="Toggle voice responses"
                            title="Toggle voice responses">
                        <MudIcon Icon="@Icons.Material.Filled.VolumeUp"
                                 Size="Size.Small"
                                 Class="oc-toggle-icon" />
                        <span>@(_speechOn ? "Voice on" : "Voice off")</span>
                    </button>
                    <button type="button"
                            class="oc-footer-toggle-btn @(_micOn ? "is-active" : "")"
                            @onclick="@(() => _micOn = !_micOn)"
                            aria-label="Toggle microphone"
                            title="Toggle microphone">
                        <MudIcon Icon="@Icons.Material.Filled.Mic"
                                 Size="Size.Small"
                                 Class="oc-toggle-icon" />
                        <span>@(_micOn ? "Mic on" : "Mic off")</span>
                    </button>
                </div>
            </footer>

            @if (_showSettings)
            {
                <div class="oc-bubble-settings">
                    <p class="oc-settings-row"><span>Placement</span><span>@Placement</span></p>
                    <p class="oc-settings-row"><span>On close</span><span>@CloseBehavior</span></p>
                    <p class="oc-settings-row"><span>Input limit</span><span>@MaxInputLength characters</span></p>
                    <p class="oc-settings-row"><span>Session</span><span>@(Session?.SessionId ?? "None")</span></p>
                </div>
            }
        </section>
    }
</div>
