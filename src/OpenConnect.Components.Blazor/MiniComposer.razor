@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@using OpenConnect.Components.Contracts
@*
  MiniComposer — Enhanced Production Floating Assistant Composer
  Referenced from SwiftAidv2 EllaiCompactComposer + EllaiLauncherMenu.
  Fully featured: 1:1 direct tracking drag handle, settings, red stop button,
  input field with dynamic equalizer-to-send switch, enter-to-send,
  dotted divider, breathing status dots, and green voice/mic toggles.
*@

<div class="oc-anchored-host @(IsAttached ? "oc-attached" : "")">
    @if (ShowFab)
    {
        <!-- Floating Launcher FAB (SwiftAidv2 pattern) -->
        <div class="oc-launcher-menu">
            <MudFab StartIcon="@FabIcon"
                    Color="Color.Default"
                    Size="Size.Large"
                    aria-label="@(_open ? $"Close {AssistantName}" : $"Open {AssistantName}")"
                    aria-expanded="@_open"
                    OnClick="@Toggle"
                    Class="@($"oc-anchored-fab {FabClass}")"
                    Style="@FabStyle" />
        </div>
    }

    @if (_open || IsAttached)
    {
        <section @ref="_panelRef"
                 class="oc-bubble"
                 role="dialog"
                 aria-modal="false"
                 aria-label="@($"{AssistantName} composer")">

            <!-- Move / Header Row: Drag Handle on Left | Settings, Stop, Close on Right -->
            <div class="oc-bubble__move-row">
                @if (!IsAttached)
                {
                    <span @ref="_handleRef"
                          class="oc-drag-handle oc-bubble__handle"
                          tabindex="0"
                          role="button"
                          style="touch-action: none; cursor: grab; user-select: none;"
                          aria-label="@($"Move {AssistantName} composer. Drag in any direction, or use the arrow keys to move and Home to reset.")"
                          title="Drag to move"
                          @onkeydown="OnHandleKeyDown">
                        <MudIcon Icon="@Icons.Material.Filled.OpenWith" Size="Size.Small" Style="pointer-events: none;" />
                    </span>
                }
                else
                {
                    <span style="width: 24px;"></span>
                }

                <!-- Test & screen reader accessible labels -->
                <span class="oc-bubble-title" style="display: none;">@AssistantName</span>
                <span class="oc-bubble-subtitle" style="display: none;">@StatusText</span>

                <span class="oc-bubble__header-actions">
                    <MudMenu @ref="_settingsMenu"
                             Icon="@Icons.Material.Filled.Settings"
                             Size="Size.Small"
                             Color="Color.Default"
                             Dense="true"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             aria-label="Composer settings"
                             title="Settings">
                        <MudPaper Elevation="0" Class="pa-3 oc-settings-menu" Style="min-width: 240px;">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Composer settings</MudText>
                            <MudButton Variant="Variant.Outlined" FullWidth="true" Size="Size.Small" StartIcon="@Icons.Material.Filled.MonitorHeart" OnClick="OpenSettingsDialogAsync">Monitoring &amp; configuration</MudButton>
                            <MudDivider Class="my-2" />

                            <MudText Typo="Typo.caption" Color="Color.Secondary">Voice</MudText>
                            <MudSwitch T="bool"
                                       Value="_speechOn"
                                       ValueChanged="OnSpeechSwitchChanged"
                                       Color="Color.Primary"
                                       Label="Voice output" />
                            <MudSwitch T="bool"
                                       Value="_micOn"
                                       ValueChanged="OnMicrophoneSwitchChanged"
                                       Color="Color.Primary"
                                       Disabled="@VoiceInputBlocked"
                                       Label="Microphone" />

                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Session</MudText>
                            <MudText Typo="Typo.body2">Placement: @Placement</MudText>
                            <MudText Typo="Typo.body2">On close: @CloseBehavior</MudText>
                            <MudText Typo="Typo.body2" Class="text-truncate">Session: @(Session?.SessionId ?? "None")</MudText>
                        </MudPaper>
                    </MudMenu>
                    <MudIconButton Icon="@Icons.Material.Filled.StopCircle"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="StopSending"
                                   Disabled="@(!IsLoading && !_sending)"
                                   aria-label="Stop reply"
                                   title="Stop reply" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="Close"
                                   aria-label="@CloseLabel"
                                   title="Close" />
                </span>
            </div>

            <!-- Input Row (SwiftAidv2 Field Wrap Pattern) -->
            <div class="oc-bubble__input-row">
                <div class="oc-bubble__field-wrap">
                    <MudTextField T="string"
                                  @key="_inputRenderKey"
                                  Value="@_draft"
                                  ValueChanged="OnInputChanged"
                                  Label="@($"Message {AssistantName}")"
                                  Placeholder="@Placeholder"
                                  MaxLength="@MaxInputLength"
                                  Lines="1"
                                  Immediate="true"
                                  Disabled="@(!CanType)"
                                  Class="oc-bubble-textfield"
                                  @onkeydown="HandleKeyDown" />
                    <span class="oc-bubble__field-actions">
                        <MudIconButton Icon="@(_micOn ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicOff)"
                                       Color="@(_micOn ? Color.Primary : Color.Default)"
                                       Size="Size.Small"
                                       OnClick="ToggleMicrophoneAsync"
                                       Disabled="@VoiceInputBlocked"
                                       aria-label="@(_micOn ? "Turn off microphone" : "Turn on microphone")"
                                       title="@(_micOn ? "Turn off microphone" : "Turn on microphone")" />

                        @if (!string.IsNullOrWhiteSpace(_draft))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Send"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="SendAsync"
                                           Disabled="@(!CanSend)"
                                           aria-label="@($"Send to {AssistantName}")"
                                           title="Send" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.GraphicEq"
                                           Color="@(_micOn || _speechOn ? Color.Primary : Color.Default)"
                                           Size="Size.Small"
                                           Class="@(_micOn || _speechOn ? "oc-bubble__live-speak oc-bubble__live-speak--active" : "oc-bubble__live-speak")"
                                           OnClick="ToggleVoiceAsync"
                                           Disabled="@VoiceInputBlocked"
                                           aria-label="Voice input"
                                           title="Voice input" />
                        }
                    </span>
                </div>
            </div>

            @if (VoiceInputChecking)
            {
                <p class="oc-voice-unavailable" role="status">Checking voice input availability…</p>
            }
            else if (VoiceInputAvailable == false)
            {
                <p class="oc-voice-unavailable" role="status">Voice input is unavailable. You can continue using text; voice output is configured separately.</p>
            }

            @if (EnableContinuousVoice)
            {
                <div class="oc-live-voice-bar" role="group" aria-label="Live voice controls">
                    <button type="button"
                            class="oc-speech-item oc-live-voice-toggle @(_duplexVoiceActive ? "oc-live-voice-toggle--active" : "")"
                            @onclick="ToggleContinuousVoiceAsync"
                            disabled="@VoiceInputBlocked"
                            aria-pressed="@_duplexVoiceActive.ToString().ToLowerInvariant()"
                            aria-label="@(_duplexVoiceActive ? "Stop live voice" : "Start live voice")"
                            title="@(_duplexVoiceActive ? "Stop live voice" : "Start live voice")">
                        <MudIcon Icon="@(_duplexVoiceActive ? Icons.Material.Filled.GraphicEq : Icons.Material.Filled.RecordVoiceOver)" Size="Size.Small" />
                        <span>@(_duplexVoiceActive ? "Live voice on" : "Live voice")</span>
                    </button>

                    @if (_duplexVoiceActive)
                    {
                        <button type="button"
                                class="oc-speech-item oc-live-voice-mute"
                                @onclick="ToggleContinuousMuteAsync"
                                aria-pressed="@_duplexMuted.ToString().ToLowerInvariant()"
                                aria-label="@(_duplexMuted ? "Unmute microphone" : "Mute microphone")"
                                title="@(_duplexMuted ? "Unmute microphone" : "Mute microphone")">
                            <MudIcon Icon="@(_duplexMuted ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)" Size="Size.Small" />
                            <span>@(_duplexMuted ? "Unmute" : "Mute")</span>
                        </button>

                        @if (string.Equals(_duplexStatus, "speaking", StringComparison.Ordinal))
                        {
                            <button type="button"
                                    class="oc-speech-item oc-live-voice-interrupt"
                                    @onclick="InterruptContinuousPlaybackAsync"
                                    aria-label="Stop speaking"
                                    title="Stop speaking">
                                <MudIcon Icon="@Icons.Material.Filled.Stop" Size="Size.Small" />
                                <span>Interrupt</span>
                            </button>
                        }

                        <button type="button"
                                class="oc-speech-item oc-live-voice-stop"
                                @onclick="StopContinuousVoiceAsync"
                                aria-label="Stop live voice session"
                                title="Stop live voice session">
                            <MudIcon Icon="@Icons.Material.Filled.StopCircle" Size="Size.Small" />
                            <span>Stop</span>
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(ContinuousVoiceStatusLabel))
                    {
                        <span class="oc-live-voice-status" role="status" aria-live="polite" aria-atomic="true">
                            @ContinuousVoiceStatusLabel
                        </span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_duplexError))
                {
                    <div class="oc-bubble-error oc-live-voice-error" role="status" aria-live="polite">@_duplexError</div>
                }
            }

            <!-- Live streaming response -->
            @if (!string.IsNullOrWhiteSpace(Session?.StreamingText) && ShouldRenderLiveResponse())
            {
                <MudText Typo="Typo.caption" Class="oc-bubble__response" aria-live="polite">
                    @RenderSpeechProgress(Session.StreamingText)
                </MudText>
            }

            <!-- Live Partial Transcript -->
            @if (!string.IsNullOrWhiteSpace(LivePartialTranscript))
            {
                <p class="oc-bubble__partial-transcript" aria-live="off">
                    @LivePartialTranscript
                </p>
            }

            <!-- Additional Conversation Messages Area (when conversation grows) -->
            @if (VisibleMessages.Count > 0)
            {
                <div class="oc-bubble-messages" role="log" aria-live="polite" aria-label="Conversation">
                    @foreach (var message in VisibleMessages)
                    {
                        <div class="oc-message @(message.Role == "user" ? "oc-message-user" : "oc-message-assistant")">
                            <span class="oc-message-role">@(message.Role == "user" ? "You" : AssistantName)</span>
                            <span class="oc-message-inline">
                                <span class="oc-message-text">@(message.Role == "assistant" && ShouldRenderSpeechProgress(message) ? RenderSpeechProgress(message.Text) : RenderMarkdown(message.Text))</span>
                                @if (message.Role == "assistant")
                                {
                                    <span class="oc-message-copy"
                                          @onclick="@(() => CopyResponseAsync(message.Text))"
                                          role="button"
                                          tabindex="0"
                                          aria-label="@CopyAriaLabel(message.Text)"
                                          title="@CopyTitle(message.Text)">
                                        <MudIcon Icon="@(_copiedResponse == message.Text ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)"
                                                 Size="Size.Small"
                                                 aria-hidden="true" />
                                    </span>
                                }
                            </span>
                        </div>
                    }
                    @if (Session?.Proposals is not null)
                    {
                        @foreach (var proposal in Session.Proposals)
                        {
                            <SafeComponentRenderer Proposal="proposal" />
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Session?.LastError))
            {
                <div class="oc-bubble-error" role="alert">
                    <span>@Session.LastError</span>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@Retry">Retry</MudButton>
                </div>
            }

            @if (!string.IsNullOrEmpty(_speechError))
            {
                <div class="oc-bubble-error" role="status">@_speechError</div>
            }

            @if (EffectiveSuggestions.Count > 0 && !IsLoading)
            {
                <div class="oc-bubble-chips" aria-label="Suggested next steps">
                    @foreach (var suggestion in EffectiveSuggestions)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => UseSuggestion(suggestion))">@suggestion</MudChip>
                    }
                </div>
            }

            <!-- Dotted Divider (SwiftAidv2 Style) -->
            <div class="oc-bubble-divider"></div>

            <!-- Status Row (SwiftAidv2 StatusLine + Voice Toggles matching Reference Image) -->
            <div class="oc-bubble__status-row">
                <div class="oc-status__line" role="status" aria-live="@(_duplexVoiceActive ? "off" : "polite")" aria-atomic="true">
                    <span class="oc-status__dots" aria-hidden="true"><i class="oc-status__dot"></i><i class="oc-status__dot"></i><i class="oc-status__dot"></i></span>
                    <span class="oc-status__text">@StatusText</span>
                </div>
                <div class="oc-bubble__speech-action">
                    <button type="button" class="oc-speech-item" @onclick="ToggleSpeechAsync" title="@(_speechOn ? "Turn off voice" : "Listen")" aria-pressed="@_speechOn.ToString().ToLowerInvariant()">
                        <MudIcon Icon="@(_speechOn ? Icons.Material.Filled.VolumeUp : Icons.Material.Filled.VolumeOff)" Size="Size.Small" />
                        <span>@(_speechOn ? "Voice on" : "Listen")</span>
                    </button>

                    <button type="button" class="oc-speech-item" @onclick="ToggleMicrophoneAsync" disabled="@VoiceInputBlocked" title="@(_micOn ? "Turn off microphone" : "Turn on microphone")" aria-pressed="@_micOn.ToString().ToLowerInvariant()">
                        <MudIcon Icon="@(_micOn ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicOff)" Size="Size.Small" />
                        <span>@(_micOn ? "Mic on" : "Mic off")</span>
                    </button>
                </div>
            </div>

        </section>
    }
</div>
