@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@using OpenConnect.Components.Contracts
@*
  MiniComposer — Enhanced Production Floating Assistant Composer
  Referenced from SwiftAidv2 EllaiCompactComposer + EllaiLauncherMenu.
  Fully featured: MudFabMenu mode selector, handle drag with 1:1 direct tracking,
  voice/mic toggles, live equalizer waveform, sent message and streaming captions,
  and 3-bar animated breathing status indicators.
*@

<div class="oc-anchored-host @(IsAttached ? "oc-attached" : "")">
    @if (ShowFab)
    {
        <!-- Floating Launcher FAB (SwiftAidv2 pattern) -->
        <div class="oc-launcher-menu">
            <MudFab StartIcon="@FabIcon"
                    Color="Color.Default"
                    Size="Size.Large"
                    aria-label="@(_open ? $"Close {AssistantName}" : $"Open {AssistantName}")"
                    aria-expanded="@_open"
                    OnClick="@Toggle"
                    Class="@($"oc-anchored-fab {FabClass}")"
                    Style="@FabStyle" />
        </div>
    }

    @if (_open || IsAttached)
    {
        <section @ref="_panelRef"
                 class="oc-bubble"
                 role="dialog"
                 aria-modal="false"
                 aria-label="@($"{AssistantName} composer")">

            <!-- Move / Header Row: Drag Handle on Left | Settings, Stop, Close on Right -->
            <div class="oc-bubble__move-row">
                @if (!IsAttached)
                {
                    <span @ref="_handleRef"
                          class="oc-drag-handle oc-bubble__handle"
                          tabindex="0"
                          role="button"
                          aria-label="@($"Move {AssistantName} composer. Drag in any direction, or use the arrow keys to move and Home to reset.")"
                          title="Drag to move"
                          @onkeydown="OnHandleKeyDown">
                        <MudIcon Icon="@Icons.Material.Filled.OpenWith" Size="Size.Small" />
                    </span>
                }
                else
                {
                    <span style="width: 24px;"></span>
                }

                <!-- Test & screen reader accessible labels -->
                <span class="oc-bubble-title" style="display: none;">@AssistantName</span>
                <span class="oc-bubble-subtitle" style="display: none;">@StatusText</span>

                <span class="oc-bubble__header-actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="@(() => _showSettings = !_showSettings)"
                                   aria-label="Composer settings"
                                   title="Settings" />
                    <MudIconButton Icon="@Icons.Material.Filled.StopCircle"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="StopSending"
                                   Disabled="@(!IsLoading)"
                                   aria-label="Stop reply"
                                   title="Stop reply" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="Close"
                                   aria-label="@CloseLabel"
                                   title="Close" />
                </span>
            </div>

            @if (IsLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="oc-bubble-progress" aria-label="Waiting for reply" />
            }

            <!-- Input Row (SwiftAidv2 Field Wrap Pattern) -->
            <div class="oc-bubble__input-row">
                <div class="oc-bubble__field-wrap">
                    <MudTextField T="string"
                                  Value="@_draft"
                                  ValueChanged="OnInputChanged"
                                  Label="@($"Message {AssistantName}")"
                                  Placeholder="@Placeholder"
                                  MaxLength="@MaxInputLength"
                                  Lines="1"
                                  Immediate="true"
                                  Disabled="@(!CanType || IsLoading)"
                                  Class="oc-bubble-textfield"
                                  @onkeydown="HandleKeyDown" />
                    <span class="oc-bubble__field-actions">
                        @if (IsLoading)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.StopCircle"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="StopSending"
                                           aria-label="Stop reply"
                                           title="Stop reply" />
                        }
                        else if (!string.IsNullOrWhiteSpace(_draft))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Send"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="SendAsync"
                                           Disabled="@(!CanSend)"
                                           aria-label="@($"Send to {AssistantName}")"
                                           title="Send" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Mic"
                                           Color="Color.Default"
                                           Size="Size.Small"
                                           OnClick="@(() => _micOn = !_micOn)"
                                           aria-label="Voice recording"
                                           title="Voice recording" />
                            <MudIconButton Icon="@Icons.Material.Filled.GraphicEq"
                                           Color="@(_speechOn ? Color.Primary : Color.Default)"
                                           Size="Size.Small"
                                           Class="@(_speechOn ? "oc-bubble__live-speak oc-bubble__live-speak--active" : "oc-bubble__live-speak")"
                                           OnClick="@(() => _speechOn = !_speechOn)"
                                           aria-label="Voice input"
                                           title="Voice input" />
                        }
                    </span>
                </div>
            </div>

            <!-- Sent Message Caption -->
            @if (!string.IsNullOrWhiteSpace(SentMessage))
            {
                <MudText Typo="Typo.caption" Class="oc-bubble__sent-message" aria-label="Your latest message">
                    @SentMessage
                </MudText>
            }

            <!-- Response / Streaming Text Caption -->
            @if (!string.IsNullOrWhiteSpace(ResponseText))
            {
                <MudText Typo="Typo.caption" Class="oc-bubble__response" aria-live="polite">
                    @ResponseText
                </MudText>
            }

            <!-- Live Partial Transcript -->
            @if (!string.IsNullOrWhiteSpace(LivePartialTranscript))
            {
                <p class="oc-bubble__partial-transcript" aria-live="off">
                    @LivePartialTranscript
                </p>
            }

            <!-- Additional Conversation Messages Area (when conversation grows) -->
            @if (VisibleMessages.Count > 0)
            {
                <div class="oc-bubble-messages" role="log" aria-live="polite" aria-label="Conversation">
                    @foreach (var message in VisibleMessages)
                    {
                        <div class="oc-message @(message.Role == "user" ? "oc-message-user" : "oc-message-assistant")">
                            <span class="oc-message-role">@(message.Role == "user" ? "You" : AssistantName)</span>
                            <p class="oc-message-text">@message.Text</p>
                        </div>
                    }
                    @if (Session?.Proposals is not null)
                    {
                        @foreach (var proposal in Session.Proposals)
                        {
                            <SafeComponentRenderer Proposal="proposal" />
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Session?.LastError))
            {
                <div class="oc-bubble-error" role="alert">
                    <span>@Session.LastError</span>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="@Retry">Retry</MudButton>
                </div>
            }

            @if (Suggestions?.Count > 0 && !IsLoading)
            {
                <div class="oc-bubble-chips" aria-label="Suggestions">
                    @foreach (var suggestion in Suggestions)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => UseSuggestion(suggestion))">@suggestion</MudChip>
                    }
                </div>
            }

            <!-- Dotted Divider (SwiftAidv2 Style) -->
            <div class="oc-bubble-divider"></div>

            <!-- Status Row (SwiftAidv2 StatusLine + Voice Toggles) -->
            <div class="oc-bubble__status-row">
                <div class="oc-status__line">
                    <span class="oc-status__motion @MotionClass" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="oc-status__text">@StatusText</span>
                </div>
                <div class="oc-bubble__speech-action">
                    <MudIconButton Icon="@(_speechOn ? Icons.Material.Filled.VolumeUp : Icons.Material.Filled.VolumeOff)"
                                   Color="@(_speechOn ? Color.Primary : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="@(() => _speechOn = !_speechOn)"
                                   aria-pressed="@(_speechOn ? "true" : "false")"
                                   aria-label="@(_speechOn ? "Turn off voice" : "Listen")"
                                   title="@(_speechOn ? "Turn off voice" : "Listen")" />
                    <span>@(_speechOn ? "Voice on" : "Listen")</span>

                    @if (_speechOn)
                    {
                        <MudIconButton Icon="@(_micOn ? Icons.Material.Filled.Mic : Icons.Material.Filled.MicOff)"
                                       Color="@(_micOn ? Color.Primary : Color.Default)"
                                       Size="Size.Small"
                                       OnClick="@(() => _micOn = !_micOn)"
                                       aria-pressed="@(_micOn ? "true" : "false")"
                                       aria-label="@(_micOn ? "Turn off microphone" : "Turn on microphone")"
                                       title="@(_micOn ? "Turn off microphone" : "Turn on microphone")" />
                        <span>@(_micOn ? "Mic on" : "Mic off")</span>
                    }
                </div>
            </div>

            @if (_showSettings)
            {
                <div class="oc-bubble-settings">
                    <p class="oc-settings-row"><span>Placement</span><span>@Placement</span></p>
                    <p class="oc-settings-row"><span>On close</span><span>@CloseBehavior</span></p>
                    <p class="oc-settings-row"><span>Input limit</span><span>@MaxInputLength characters</span></p>
                    <p class="oc-settings-row"><span>Session</span><span>@(Session?.SessionId ?? "None")</span></p>
                </div>
            }
        </section>
    }
</div>
