<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(OpenConnectLibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>OpenConnect.Components.Contracts</AssemblyName>
    <RootNamespace>OpenConnect.Components.Contracts</RootNamespace>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Public-API tracking (CF-IMP-005e-A): project-local so no repo-wide effects. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
