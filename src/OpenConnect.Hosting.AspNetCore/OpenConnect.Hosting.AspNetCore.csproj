<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(OpenConnectLibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>OpenConnect.Hosting.AspNetCore</AssemblyName>
    <RootNamespace>OpenConnect.Hosting.AspNetCore</RootNamespace>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Public-API tracking (CF-IMP-005e-A): project-local so no repo-wide effects. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../OpenConnect.Core/OpenConnect.Core.csproj" />
    <ProjectReference Include="../OpenConnect.Agents/OpenConnect.Agents.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
