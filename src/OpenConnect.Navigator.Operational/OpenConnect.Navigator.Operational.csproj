<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFrameworks>$(OpenConnectLibraryTargetFrameworks)</TargetFrameworks><AssemblyName>OpenConnect.Navigator.Operational</AssemblyName><RootNamespace>OpenConnect.Navigator.Operational</RootNamespace><NoWarn>$(NoWarn);1591</NoWarn><!-- Public-API tracking (CF-IMP-005e-C): project-local so no repo-wide effects. --><EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../OpenConnect.Navigator/OpenConnect.Navigator.csproj" />
    <ProjectReference Include="../OpenConnect.Persistence.EFCore/OpenConnect.Persistence.EFCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
