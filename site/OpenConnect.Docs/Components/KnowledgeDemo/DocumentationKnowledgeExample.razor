@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using System.Text.Json
@using OpenConnect.Docs.Services.KnowledgeDemo
@inject IServiceProvider Services

<section class="doc-card" aria-labelledby="documentation-knowledge-title">
    <h2 id="documentation-knowledge-title">Try knowledge search</h2>
    @if (Services.GetService<IDocumentationKnowledgeDemo>() is null)
    {
        <p>The knowledge example is not configured. The guide below describes the required index, embedding and search services.</p>
    }
    else
    {
        <p>Search an operator-approved synthetic document. Passages are source evidence and require review.</p>
        <label for="documentation-knowledge-query">Question</label>
        <input id="documentation-knowledge-query" value="@_query" @oninput="OnQueryChanged" maxlength="2000" disabled="@_busy" />
        <button id="documentation-knowledge-search" type="button" class="button" @onclick="SearchAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_query))">Search document</button>
        @if (_status is not null) { <p role="status">@_status</p> }
        @if (_result is not null)
        {
            <section aria-labelledby="documentation-knowledge-results">
                <h3 id="documentation-knowledge-results">Relevant passages</h3>
                @if (_result.RootElement.GetProperty("result").GetProperty("warnings").GetArrayLength() != 0)
                {
                    <p role="alert">Some passages were excluded because access or the source changed. Results may be incomplete; search again.</p>
                }
                @if (_result.RootElement.GetProperty("result").GetProperty("hits").GetArrayLength() == 0)
                {
                    <p>No matching passages were found.</p>
                }
                @foreach (var item in _result.RootElement.GetProperty("result").GetProperty("hits").EnumerateArray())
                {
                    var hit = item.GetProperty("hit");
                    <article>
                        <p>@hit.GetProperty("text").GetString()</p>
                        <p>Source: @hit.GetProperty("document_id").GetString(), revision @hit.GetProperty("source_revision").GetString(), page @(hit.GetProperty("page_index").GetInt32() + 1), characters @hit.GetProperty("start").GetInt32()–@hit.GetProperty("end").GetInt32().</p>
                    </article>
                }
            </section>
        }
    }
</section>

@code {
    private readonly CancellationTokenSource _stopping = new();
    private string _query = string.Empty;
    private string? _status;
    private JsonDocument? _result;
    private bool _busy;
    private bool _disposed;

    private void OnQueryChanged(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _result?.Dispose();
        _result = null;
        _status = null;
    }

    private async Task SearchAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_query) || Services.GetService<IDocumentationKnowledgeDemo>() is not { } demo) return;
        _busy = true; _status = "Preparing and searching the document…";
        _result?.Dispose(); _result = null;
        try
        {
            var result = await demo.SearchAsync(_query, _stopping.Token);
            if (_disposed) { result.Dispose(); return; }
            _result = result; _status = "Search complete. Review the cited passages.";
        }
        catch (OperationCanceledException) when (_stopping.IsCancellationRequested) { }
        catch (Exception) { if (!_disposed) _status = "Search could not be completed. Try again later or refresh the page."; }
        finally { _busy = false; }
    }

    public void Dispose()
    {
        _disposed = true; _stopping.Cancel(); _stopping.Dispose(); _result?.Dispose();
    }
}
