@page "/docs/{Version}/{Slug}"
@inject DocumentationContentStore Content
@inject NavigationManager Navigation
@using OpenConnect.Docs.Components.PrivacyDemo
@using OpenConnect.Docs.Components.DocumentDemo
@using OpenConnect.Docs.Components.KnowledgeDemo
@using OpenConnect.Docs.Components.AnalyticsDemo
@using OpenConnect.Docs.Components.VoiceBenchmark

@if (Document is null)
{
    <NotFound />
}
else
{
    <PageTitle>@Document.Title · OpenConnect</PageTitle>
    <HeadContent><link rel="canonical" href="/docs/@Document.Version/@Document.Slug" /><meta name="description" content="@Document.Summary" /><meta property="og:title" content="@Document.Title" /></HeadContent>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/docs">Docs</a><span>/</span><span>@Document.Title</span></nav>
    <div class="doc-heading"><span class="version-label">@Document.Version</span><h1>@Document.Title</h1><p>@Document.Summary</p></div>
    <div class="doc-layout">
        <div class="doc-article">
            @if (Document.Version == "v1" && Document.Slug == "privacy")
            {
                <PrivacyDemo />
            }
            @if (Document.Version == "v1" && Document.Slug == "documents-and-knowledge")
            {
                <DocumentationDocumentExample />
                <DocumentationKnowledgeExample />
            }
            @if (Document.Version == "v1" && Document.Slug == "supported-services")
            {
                <DocumentationAnalyticsExample />
            }
            @if (Document.Version == "v1" && Document.Slug == "voice-and-translation")
            {
                <LiveVoiceBenchmarkDashboard />
            }
            <MarkdownRenderer Markdown="@Document.Markdown" />
            <p class="edit-link"><a href="https://github.com/Vuminkosi/open-connect/edit/master/site/OpenConnect.Docs/Content/@Document.Version/@($"{Document.Slug}.md")">Edit this page on GitHub</a></p>
        </div>
        @if (Headings.Count > 0)
        {
            <aside class="doc-toc" aria-label="On this page">
                <details open>
                    <summary>On this page</summary>
                    <nav aria-label="Page sections">
                        <ul>
                            @foreach (var heading in Headings)
                            {
                                <li class="@(heading.Level == 3 ? "doc-toc-subsection" : null)"><a href="@($"/docs/{Document.Version}/{Document.Slug}#{Uri.EscapeDataString(heading.Id)}")">@heading.Text</a></li>
                            }
                        </ul>
                    </nav>
                </details>
            </aside>
        }
    </div>
}

@code {
    [Parameter] public string Version { get; set; } = "";
    [Parameter] public string Slug { get; set; } = "";
    private DocumentationDocument? Document;
    private IReadOnlyList<DocumentationHeading> Headings = [];
    protected override void OnParametersSet()
    {
        Document = Content.Find(Version, Slug);
        Headings = Document is null ? [] : DocumentationHeadingIds.Extract(Document.Markdown);
    }
}
