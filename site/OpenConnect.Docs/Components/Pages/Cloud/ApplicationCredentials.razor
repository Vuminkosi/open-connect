@page "/cloud/tenants/{TenantId:guid}/applications/{ApplicationId:guid}/credentials"
@attribute [Authorize]
@layout Layout.CloudLayout
@rendermode InteractiveServer
@implements IDisposable
@using OpenConnect.Docs.Cloud
@inject IServiceProvider Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject ILogger<ApplicationCredentials> Logger

<PageTitle>Application credentials | OpenConnect Cloud</PageTitle>
<h1>Application credentials</h1>
<p>Use these keys only from your application server. Store each key in a secret store; it is shown only once.</p>
@if (_loading)
{
    <p role="status">Loading credentials…</p>
}
else
{
    @if (!string.IsNullOrEmpty(_status)) { <p role="status">@_status</p> }
    @if (_secret is not null)
    {
        <section aria-labelledby="new-key-title">
            <h2 id="new-key-title">Save this key now</h2>
            <p>This key cannot be shown again. Do not embed it in browser or mobile application code.</p>
            <code style="overflow-wrap:anywhere">@_secret</code>
            <button type="button" class="button" @onclick="() => _secret = null">Done</button>
        </section>
    }
    @if (_loaded && _canAdminister)
    {
        <h2>Create a credential</h2>
        <fieldset>
            <legend>Enabled services</legend>
            @if (_available.Count == 0) { <p>No services are currently available for this application.</p> }
            @foreach (var capability in _available)
            {
                <label><input type="checkbox" disabled="@(!_interactive || _busy)" checked="@_scopes.Contains(capability.Id)" @onchange="e => SelectScope(capability.Id, e.Value is true)" /> @capability.Name</label>
            }
        </fieldset>
        <p>Selected services: @_scopes.Count</p>
        <label for="credential-expiry">Expiration (UTC)</label>
        <input id="credential-expiry" type="datetime-local" disabled="@(!_interactive || _busy)" value="@_expiryText" @onchange="e => _expiryText = e.Value?.ToString()" />
        @if (Expiry is not null) { <p>Selected expiration: @Expiry.Value.ToString("yyyy-MM-dd HH:mm") UTC</p> }
        <button type="button" class="button primary" disabled="@(_busy || !_interactive || _available.Count == 0)" @onclick="CreateAsync">Create credential</button>
    }
    @if (_loaded)
    {
        <h2>Existing credentials</h2>
        @if (_credentials.Count == 0) { <p>No credentials are available.</p> }
        else
        {
        <ul class="cloud-list">
            @foreach (var credential in _credentials)
            {
                <li>
                    <strong>@credential.Fingerprint</strong> <span>@credential.Environment · @string.Join(", ", credential.Scopes)</span>
                    <span>Expires: @(credential.ExpiresAt?.ToString("u") ?? "Not set") · @CredentialStatus(credential)</span>
                    @if (_canAdminister && credential.RevokedAt is null)
                    {
                        <button type="button" class="button" aria-label="@($"Rotate credential {credential.Fingerprint} using expiration above")" disabled="@(_busy || !_interactive)" @onclick="() => RotateAsync(credential.Id)">Rotate using expiration above</button>
                        <button type="button" class="button" aria-label="@($"Revoke credential {credential.Fingerprint}")" disabled="@(_busy || !_interactive)" @onclick="() => RevokeAsync(credential.Id)">Revoke</button>
                    }
                </li>
            }
        </ul>
        }
        <section aria-labelledby="onboarding-snippets-title">
            <h2 id="onboarding-snippets-title">Connect your application</h2>
            <p>Send your server credential from a backend service using the <code>Authorization</code> header. Replace <code>&lt;YOUR_API_KEY&gt;</code> with a secret loaded from your secret store.</p>
            <h3>.NET</h3>
            <pre><code>@DotNetSnippet</code></pre>
            <h3>REST</h3>
            <pre><code>@RestSnippet</code></pre>
            <h3>TypeScript</h3>
            <pre><code>@TypeScriptSnippet</code></pre>
        </section>
    }
}

@code {
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public Guid ApplicationId { get; set; }
    private CloudCredentialService? _credentialsService;
    private CloudCapabilityService? _capabilitiesService;
    private CloudControlPlaneService? _tenantService;
    private IReadOnlyList<CloudCredentialSummary> _credentials = [];
    private IReadOnlyList<CloudCapabilityView> _available = [];
    private readonly HashSet<string> _scopes = new(StringComparer.Ordinal);
    private string? _expiryText;
    private string? _secret;
    private string? _status;
    private bool _loading = true;
    private bool _loaded;
    private bool _busy;
    private bool _canAdminister;
    private bool _interactive;
    private int _generation;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _interactive = true; StateHasChanged(); }
    }

    protected override async Task OnParametersSetAsync()
    {
        _generation++;
        _secret = null;
        _busy = false;
        _expiryText = null;
        _scopes.Clear();
        _credentials = [];
        _available = [];
        _canAdminister = false;
        _loaded = false;
        _credentialsService = Services.GetService(typeof(CloudCredentialService)) as CloudCredentialService;
        _capabilitiesService = Services.GetService(typeof(CloudCapabilityService)) as CloudCapabilityService;
        _tenantService = Services.GetService(typeof(CloudControlPlaneService)) as CloudControlPlaneService;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var generation = _generation;
        var tenantId = TenantId;
        var applicationId = ApplicationId;
        _loading = true;
        _loaded = false;
        _canAdminister = false;
        try
        {
            var subject = await GetSubjectAsync();
            if (generation != _generation) return;
            if (subject is null || _credentialsService is null || _capabilitiesService is null || _tenantService is null)
            { _status = "Credential management is unavailable."; return; }
            var tenant = (await _tenantService.GetTenantsAsync(subject, CancellationToken.None)).SingleOrDefault(x => x.Id == tenantId);
            var (credentials, _) = await _credentialsService.ListAsync(subject, tenantId, applicationId, CancellationToken.None);
            var capabilities = await _capabilitiesService.GetApplicationCapabilitiesAsync(subject, tenantId, applicationId, CancellationToken.None);
            if (generation != _generation) return;
            if (tenant is null || credentials is null || capabilities is null)
            { _status = "The application was not found or you do not have access."; return; }
            _canAdminister = tenant.Role is "Owner" or "Administrator";
            _credentials = credentials;
            _available = capabilities.Where(x => string.IsNullOrEmpty(x.ReasonCode)).ToArray();
            _loaded = true;
            _status = null;
        }
        catch (Exception)
        { Logger.LogWarning("Cloud credential lookup failed."); if (generation == _generation) _status = "Credentials could not be loaded. Try again."; }
        finally { if (generation == _generation) _loading = false; }
    }

    private void SelectScope(string id, bool selected) { if (selected) _scopes.Add(id); else _scopes.Remove(id); }
    private static string CredentialStatus(CloudCredentialSummary credential) => credential.RevokedAt is not null
        ? "Revoked" : credential.ExpiresAt is null || credential.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired" : "Active";
    private DateTimeOffset? Expiry => DateTime.TryParseExact(_expiryText, ["yyyy-MM-dd'T'HH:mm", "yyyy-MM-dd'T'HH:mm:ss"],
        System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var expiry)
        ? new DateTimeOffset(DateTime.SpecifyKind(expiry, DateTimeKind.Utc)) : null;
    private async Task CreateAsync() => await IssueAsync(null);
    private async Task RotateAsync(Guid id) => await IssueAsync(id);
    private async Task IssueAsync(Guid? credentialId)
    {
        var generation = _generation;
        var tenantId = TenantId;
        var applicationId = ApplicationId;
        var scopes = _scopes.ToArray();
        var expiry = Expiry;
        _busy = true; _secret = null;
        try
        {
            var subject = await GetSubjectAsync();
            if (generation != _generation) return;
            if (subject is null || _credentialsService is null) { _status = "Your session is unavailable."; return; }
            var result = credentialId is null
                ? await _credentialsService.CreateAsync(subject, tenantId, applicationId, scopes, expiry, CancellationToken.None)
                : await _credentialsService.RotateAsync(subject, tenantId, applicationId, credentialId.Value, expiry, CancellationToken.None);
            if (generation != _generation) return;
            if (result.Status != "succeeded") { _status = $"Credential could not be issued: {result.Status}."; return; }
            _secret = result.Secret;
            await ReloadAsync();
        }
        catch (Exception) { Logger.LogWarning("Cloud credential issuance failed."); if (generation == _generation) _status = "The credential was not confirmed. Reload before trying again."; }
        finally { if (generation == _generation) _busy = false; }
    }
    private async Task RevokeAsync(Guid id)
    {
        var generation = _generation;
        var tenantId = TenantId;
        var applicationId = ApplicationId;
        _busy = true; _secret = null;
        try
        {
            var subject = await GetSubjectAsync();
            if (generation != _generation) return;
            if (subject is null || _credentialsService is null) { _status = "Your session is unavailable."; return; }
            var result = await _credentialsService.RevokeAsync(subject, tenantId, applicationId, id, CancellationToken.None);
            if (generation != _generation) return;
            await ReloadAsync();
            if (generation == _generation && result != "succeeded") _status = "The credential was not confirmed as revoked.";
        }
        catch (Exception) { Logger.LogWarning("Cloud credential revocation failed."); if (generation == _generation) _status = "The credential was not confirmed as revoked."; }
        finally { if (generation == _generation) _busy = false; }
    }
    private const string DotNetSnippet = """
        builder.Services.AddOpenConnect(options =>
        {
            options.Cloud.ApiKey = builder.Configuration["OpenConnect:ApiKey"] ?? "<YOUR_API_KEY>";
        });
        """;

    private const string RestSnippet = """
        curl -X POST "https://cloud.openconnect.example/v1/classify" \
          -H "Authorization: Bearer <YOUR_API_KEY>" \
          -H "Content-Type: application/json" \
          -d '{"input":"Sample text"}'
        """;

    private const string TypeScriptSnippet = """
        const response = await fetch("https://cloud.openconnect.example/v1/classify", {
          method: "POST",
          headers: {
            Authorization: `Bearer ${process.env.OPENCONNECT_API_KEY ?? "<YOUR_API_KEY>"}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ input: "Sample text" }),
        });
        """;

    private async Task<CloudSubject?> GetSubjectAsync() => CloudSubjectResolver.FromPrincipal(
        (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User, Configuration["OpenConnect:Cloud:Identity:Authority"]);
    public void Dispose() { _generation++; _secret = null; }
}
