@page "/cloud"
@attribute [Authorize]
@layout Layout.CloudLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using OpenConnect.Docs.Cloud
@inject IServiceProvider Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject CloudOperatorAccess OperatorAccess
@inject ILogger<Overview> Logger

<PageTitle>Cloud overview | OpenConnect</PageTitle>
<section class="hero cloud-hero">
    <p class="eyebrow">Authenticated workspace</p>
    <h1>OpenConnect Cloud</h1>
    <p>Cloud administration is separate from public documentation. Service entitlements, usage, and security evidence appear only when their control-plane sources are connected.</p>
    @if (_isOperator) { <p><a href="/cloud/operator">Manage worker deployments</a> · <a href="/cloud/operator/regions">Manage catalog regions</a> · <a href="/cloud/operator/entitlements">Manage entitlements</a> · <a href="/cloud/operator/liveui-reconciliation">View unresolved LiveUI usage</a></p> }
</section>
<section aria-labelledby="organizations-title">
    <h2 id="organizations-title">Organizations</h2>
    <p><a href="/cloud/invitations/accept">Accept an invitation</a></p>
    @if (_loading)
    {
        <p role="status">Loading organizations…</p>
    }
    else if (_controlPlane is null)
    {
        <p role="status">@_status</p>
    }
    else if (!string.IsNullOrEmpty(_status))
    {
        <p role="status">@_status</p>
    }
    else if (_tenants.Count == 0)
    {
        <p>No organizations are connected to your account yet. Create one to begin.</p>
    }
    @if (_tenants.Count > 0)
    {
        <ul class="cloud-list">
            @foreach (var tenant in _tenants)
            {
                <li>
                    <strong>@tenant.Name</strong> <span>Role: @tenant.Role</span>
                    <a href="/cloud/tenants/@tenant.Id/applications">Applications</a>
                    <a href="/cloud/tenants/@tenant.Id/services">Services</a>
                    <a href="/cloud/tenants/@tenant.Id/regions">Allowed regions</a>
                    <a href="/cloud/tenants/@tenant.Id/inference-models">Inference model policy</a>
                    @if (tenant.Role is "Owner" or "Administrator" or "SecurityAnalyst")
                    {
                        <a href="/cloud/tenants/@tenant.Id/security">Security observations</a>
                    }
                    @if (tenant.Role is "Owner" or "Administrator" or "BillingReader")
                    {
                        <a href="/cloud/tenants/@tenant.Id/quotas">Quotas</a>
                        <a href="/cloud/tenants/@tenant.Id/usage">Usage</a>
                    }
                    @if (tenant.Role is "Owner" or "Administrator")
                    {
                        <a href="/cloud/tenants/@tenant.Id/members">Members</a>
                    }
                </li>
            }
        </ul>
    }
    @if (_controlPlane is not null)
    {
        <EditForm Model="_newTenant" OnValidSubmit="CreateTenantAsync" FormName="create-cloud-tenant">
            <DataAnnotationsValidator />
            <label for="cloud-tenant-name">New organization name</label>
            <InputText id="cloud-tenant-name" @bind-Value="_newTenant.Name" maxlength="200" disabled="@(!_interactive || _saving)" />
            <ValidationMessage For="() => _newTenant.Name" />
            <button class="button primary" type="submit" disabled="@(_saving || !_interactive)">Create organization</button>
        </EditForm>
    }
</section>
<section class="cards cloud-status" aria-label="Cloud service status">
    <article><h2>Service catalog</h2><p>Open an organization's services to review entitlements, selections and platform availability. Applications also need an authorized credential and a ready deployment.</p></article>
    <article><h2>Security evidence</h2><p>Authorized security roles can review recorded observations for each organization when evidence is available.</p></article>
</section>

@code {
    private readonly TenantForm _newTenant = new();
    private CloudControlPlaneService? _controlPlane;
    private IReadOnlyList<CloudTenantSummary> _tenants = [];
    private bool _loading = true;
    private bool _saving;
    private bool _interactive;
    private bool _isOperator;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _interactive = true; StateHasChanged(); }
    }
    private string? _status;

    protected override async Task OnInitializedAsync()
    {
        _isOperator = OperatorAccess.IsAllowed((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
        _controlPlane = Services.GetService(typeof(CloudControlPlaneService)) as CloudControlPlaneService;
        if (_controlPlane is null)
        {
            _status = "The Cloud control plane is not configured. Organization data is unavailable.";
            _loading = false;
            return;
        }

        await ReloadTenantsAsync();
    }

    private async Task CreateTenantAsync()
    {
        if (_controlPlane is null)
        {
            return;
        }

        _saving = true;
        _status = null;
        try
        {
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var subject = CloudSubjectResolver.FromPrincipal(authentication.User, Configuration["OpenConnect:Cloud:Identity:Authority"]);
            if (subject is null)
            {
                _status = "The authenticated identity is missing a subject. Sign in again or contact the identity administrator.";
                return;
            }

            await _controlPlane.CreateTenantAsync(subject, _newTenant.Name!, CancellationToken.None);
            _newTenant.Name = string.Empty;
            await ReloadTenantsAsync();
        }
        catch (Exception)
        {
            Logger.LogWarning("Cloud organization creation failed; no database details were returned to the browser.");
            _status = "The Cloud control plane is temporarily unavailable. The organization was not confirmed as created.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReloadTenantsAsync()
    {
        _loading = true;
        _status = null;
        try
        {
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var subject = CloudSubjectResolver.FromPrincipal(authentication.User, Configuration["OpenConnect:Cloud:Identity:Authority"]);
            if (subject is null)
            {
                _status = "The authenticated identity is missing a subject.";
                return;
            }

            _tenants = await _controlPlane!.GetTenantsAsync(subject, CancellationToken.None);
        }
        catch (Exception)
        {
            Logger.LogWarning("Cloud organization lookup is unavailable; no database details were returned to the browser.");
            _status = "The Cloud control plane is temporarily unavailable. Organization membership could not be verified.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class TenantForm
    {
        [Required, StringLength(200, MinimumLength = 1)]
        public string? Name { get; set; }
    }
}
