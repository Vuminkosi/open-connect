@page "/cloud/operator/liveui-reconciliation"
@attribute [Authorize]
@layout Layout.CloudLayout
@rendermode InteractiveServer
@using OpenConnect.Docs.Cloud
@inject IServiceProvider Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<OperatorLiveUIReconciliation> Logger

<PageTitle>LiveUI reconciliation | OpenConnect Cloud</PageTitle>
<h1>LiveUI usage requiring reconciliation</h1>
<p>These expired requests were consumed, but no token measurement was recorded. Their quota remains reserved until the usage can be reconciled.</p>
@if (_loading)
{
    <p role="status">Loading requests…</p>
}
else if (_error is not null)
{
    <p role="status">@_error</p>
    <button class="button" type="button" disabled="@(!_interactive || _busy)" @onclick="RefreshAsync">Try again</button>
}
else
{
    <button class="button" type="button" disabled="@(!_interactive || _busy)" @onclick="RefreshAsync">Refresh</button>
    @if (_cases.Count == 0)
    {
        <p>No unmeasured consumed LiveUI requests are awaiting reconciliation on this page.</p>
    }
    else
    {
        <div class="cloud-list">
            @foreach (var item in _cases)
            {
                <article>
                    <h2>Request @item.RequestId</h2>
                    <dl>
                        <dt>Organization</dt><dd>@item.TenantId</dd>
                        <dt>Application</dt><dd>@item.ApplicationId</dd>
                        <dt>Deployment</dt><dd>@item.DeploymentId</dd>
                        <dt>Reservation</dt><dd>@item.ReservationId</dd>
                        <dt>Expired at (UTC)</dt><dd>@item.ExpiresAt.ToString("u")</dd>
                        <dt>Reserved tokens</dt><dd>@item.ReservedTokens</dd>
                        <dt>Actual tokens</dt><dd>Unknown</dd>
                    </dl>
                </article>
            }
        </div>
    }
    <nav aria-label="Reconciliation pages">
        <button class="button" type="button" disabled="@(!_interactive || _busy || _previous.Count == 0)" @onclick="PreviousAsync">Previous</button>
        <button class="button" type="button" disabled="@(!_interactive || _busy || _next is null)" @onclick="NextAsync">Next</button>
    </nav>
}

@code {
    private IReadOnlyList<CloudLiveUIUnknownUsage> _cases = [];
    private readonly Stack<CloudLiveUIReconciliationCursor?> _previous = new();
    private CloudLiveUIReconciliationCursor? _current, _next;
    private string? _error;
    private bool _loading = true, _busy, _interactive;

    protected override void OnAfterRender(bool firstRender) { if (firstRender) { _interactive = true; StateHasChanged(); } }
    protected override async Task OnInitializedAsync() => await LoadAsync(null);

    private async Task LoadAsync(CloudLiveUIReconciliationCursor? cursor)
    {
        _busy = true;
        try
        {
            if (Services.GetService(typeof(CloudLiveUIReconciliation)) is not CloudLiveUIReconciliation reconciliation)
            {
                _error = "The Cloud control plane is not configured.";
                return;
            }
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var page = await reconciliation.ListUnknownAsync(principal, cursor, 20, CancellationToken.None);
            if (page.Status != "succeeded") { _error = "Operator access is required."; return; }
            _cases = page.Cases ?? []; _current = cursor; _next = page.Next; _error = null;
        }
        catch (Exception)
        {
            Logger.LogWarning("Cloud LiveUI reconciliation list could not be loaded.");
            _error = "Reconciliation is temporarily unavailable.";
        }
        finally { _loading = false; _busy = false; }
    }

    private async Task RefreshAsync() { _previous.Clear(); await LoadAsync(null); }
    private async Task NextAsync() { if (_next is not null) { _previous.Push(_current); await LoadAsync(_next); } }
    private async Task PreviousAsync() { if (_previous.TryPop(out var cursor)) await LoadAsync(cursor); }
}
