@page "/cloud/tenants/{TenantId:guid}/security"
@attribute [Authorize]
@layout Layout.CloudLayout
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using OpenConnect.Docs.Cloud
@inject IServiceProvider Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject ILogger<TenantSecurity> Logger

<PageTitle>Security observations | OpenConnect Cloud</PageTitle>
<h1>Security observations</h1>
<VoicePrivacyObservations TenantId="@TenantId" />
<p>
    <a href="@($"/cloud/tenants/{TenantId}/security/host-reports")">View host privacy reports</a>
    ·
    <a href="@($"/cloud/tenants/{TenantId}/security/playground")">Open Security Playground</a>
</p>
<p>Cloud classification checks and host privacy reports are shown separately. Analytics privacy cases are also shown separately. A passed check does not prove complete detection or worker execution. Repeated requests can create multiple observations.</p>
<div class="security-filter">
    <label for="security-from">From date (UTC)</label><input id="security-from" type="date" value="@_fromDate" @onchange="e => _fromDate = e.Value?.ToString()" disabled="@(!_interactive || _loading)" />
    <label for="security-to">Through date (UTC)</label><input id="security-to" type="date" value="@_toDate" @onchange="e => _toDate = e.Value?.ToString()" disabled="@(!_interactive || _loading)" />
    <button class="button" type="button" disabled="@(!_interactive || _loading)" @onclick="ApplyDatesAsync">Apply dates</button>
</div>
@if (_loading) { <p role="status">Loading security observations…</p> }
else if (_status is not null) { <p role="status">@_status</p> }
else if (_page is not null)
{
    @if (_statistics is not null)
    {
        <section aria-label="Cloud classification observation counts">
            <h2>Recorded Cloud checks</h2>
            <p>Counts cover the selected date range and include repeat requests.</p>
            <dl>
                <dt>Allowed</dt><dd>@_statistics.Allowed</dd>
                <dt>Blocked</dt><dd>@_statistics.Blocked</dd>
                <dt>Detector unavailable</dt><dd>@_statistics.DetectorUnavailable</dd>
            </dl>
            <h3>Detected sensitive information</h3>
            <p>Counts are detected items in recorded Cloud checks, including repeats; they do not include application-host inspection. Category evidence was unavailable for @_statistics.CategoryEvidenceUnavailable checks.</p>
            @if (_statistics.Categories.Count == 0) { <p>No category counts were recorded.</p> }
            else { <ul>@foreach (var category in _statistics.Categories) { <li>@category.Category: @category.Count</li> }</ul> }
        </section>
    }
    @if (_page.Observations.Count == 0) { <p>No Cloud classification observations were found for this period.</p> }
    else
    {
        <div class="cloud-capabilities">
            @foreach (var observation in _page.Observations)
            {
                <article class="security-observation">
                    <h2>@OutcomeLabel(observation.Outcome)</h2>
                    <dl>
                        <dt>Observation ID</dt><dd><code>@observation.Id</code></dd>
                        <dt>Observed at (UTC)</dt><dd>@observation.OccurredAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt>Application ID</dt><dd><code>@observation.ApplicationId</code></dd>
                        <dt>Request ID</dt><dd><code>@observation.RequestId</code></dd>
                        <dt>Trace ID</dt><dd><code>@observation.TraceId</code></dd>
                        <dt>Cloud action</dt><dd>@ActionLabel(observation.Outcome)</dd>
                        <dt>Detected categories</dt>
                        <dd>
                            @if (observation.Categories is null) { <span>Not recorded for this observation.</span> }
                            else if (observation.Categories.Count == 0) { <span>None recorded.</span> }
                            else { <ul>@foreach (var category in observation.Categories) { <li>@category.Category: @category.Count</li> }</ul> }
                        </dd>
                    </dl>
                    <a href="@($"/cloud/tenants/{TenantId}/security/cases/{observation.Id}")">Review case evidence</a>
                </article>
            }
        </div>
    }
    <nav aria-label="Security observation pages">
        <button class="button" type="button" disabled="@(!_interactive || _loading || _pageIndex == 0)" @onclick="PreviousAsync">Previous</button>
        <button class="button" type="button" disabled="@(!_interactive || _loading || _page.Next is null)" @onclick="NextAsync">Next</button>
    </nav>
    @if (_analytics is not null)
    {
        <section aria-label="Analytics privacy cases">
            <h2>Analytics privacy cases</h2>
            <p>All recorded analytics checks are counted, including repeats. The most recent 50 cases are shown. Date filters above do not apply. Inspection can stop after a block, so category counts are not a complete inventory.</p>
            <h3>Recorded decisions</h3>
            @if (_analytics.Totals.Count == 0) { <p>No analytics privacy decisions were recorded.</p> }
            else { <ul>@foreach (var total in _analytics.Totals) { <li>@total.Direction — @total.Outcome: @total.Count</li> }</ul> }
            <h3>Detected categories</h3>
            @if (_analytics.Categories.Count == 0) { <p>No sensitive categories were recorded.</p> }
            else { <ul>@foreach (var category in _analytics.Categories) { <li>@category.Direction — @category.Category: @category.Count</li> }</ul> }
            @foreach (var item in _analytics.RecentCases)
            {
                <article class="security-observation">
                    <h3>@item.Direction — @item.Outcome</h3>
                    <dl>
                        <dt>Case ID</dt><dd><code>@item.Id</code></dd>
                        <dt>Observed at (UTC)</dt><dd>@item.OccurredAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt>Application ID</dt><dd><code>@item.ApplicationId</code></dd>
                        <dt>Request ID</dt><dd><code>@item.RequestId</code></dd>
                        <dt>Trace ID</dt><dd><code>@item.TraceId</code></dd>
                        <dt>Action</dt><dd>@(item.Outcome == "allowed" ? "Allowed by the privacy check; execution is not confirmed." : "Content was blocked at this boundary.")</dd>
                        <dt>Detected categories</dt><dd>
                            @if (item.Categories.Count == 0) { <span>None recorded.</span> }
                            else { <ul>@foreach (var category in item.Categories) { <li>@category.Category: @category.Count</li> }</ul> }
                        </dd>
                    </dl>
                </article>
            }
        </section>
    }
    @if (_embedding is not null)
    {
        <section aria-label="Embedding privacy cases">
            <h2>Embedding privacy cases</h2>
            <p>All recorded embedding checks are counted, including repeats. The most recent 50 cases are shown. Date filters above do not apply. Inspection can stop after a block, so category counts are not a complete inventory.</p>
            <h3>Recorded decisions</h3>
            @if (_embedding.Totals.Count == 0) { <p>No embedding privacy decisions were recorded.</p> }
            else { <ul>@foreach (var total in _embedding.Totals) { <li>@total.Direction — @total.Outcome: @total.Count</li> }</ul> }
            <h3>Detected categories</h3>
            @if (_embedding.Categories.Count == 0) { <p>No sensitive categories were recorded.</p> }
            else { <ul>@foreach (var category in _embedding.Categories) { <li>@category.Direction — @category.Category: @category.Count</li> }</ul> }
            @foreach (var item in _embedding.RecentCases)
            {
                <article class="security-observation">
                    <h3>@item.Direction — @item.Outcome</h3>
                    <dl>
                        <dt>Case ID</dt><dd><code>@item.Id</code></dd>
                        <dt>Observed at (UTC)</dt><dd>@item.OccurredAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt>Application ID</dt><dd><code>@item.ApplicationId</code></dd>
                        <dt>Request ID</dt><dd><code>@item.RequestId</code></dd>
                        <dt>Trace ID</dt><dd><code>@item.TraceId</code></dd>
                        <dt>Action</dt><dd>@(item.Outcome == "allowed" ? "Allowed by the privacy check; execution is not confirmed." : "Content was blocked at this boundary.")</dd>
                        <dt>Detected categories</dt><dd>
                            @if (item.Categories.Count == 0) { <span>None recorded.</span> }
                            else { <ul>@foreach (var category in item.Categories) { <li>@category.Category: @category.Count</li> }</ul> }
                        </dd>
                    </dl>
                </article>
            }
        </section>
    }
    @if (_hostPage is not null)
    {
        <section aria-label="Host privacy reports">
            <h2>Host privacy reports</h2>
            <p>These reports record host firewall decisions; a caller may apply additional checks before content proceeds. Cloud classification date filters do not apply. Each report represents one recorded decision. Category counts are detector matches and may include overlapping or repeated matches. Inspection may stop after a block, so counts do not represent a complete inventory of sensitive information.</p>
            @if (_hostPage.Statistics is { } hostStats)
            {
                <h3>All recorded host decisions</h3>
                <dl><dt>Other destinations</dt><dd>@hostStats.OtherDestinations</dd><dt>Output boundary</dt><dd>@hostStats.OutputDecisions</dd>
                    <dt>Firewall allowed</dt><dd>@hostStats.Allowed</dd><dt>Firewall blocked</dt><dd>@hostStats.Blocked</dd></dl>
                <h3>Recorded policy actions</h3>
                @if (hostStats.Actions.Count == 0) { <p>No policy actions were recorded.</p> }
                else { <ul>@foreach (var action in hostStats.Actions) { <li>@action.Action: @action.Count</li> }</ul> }
                <h3>Recorded decision reasons</h3>
                @if (hostStats.Reasons.Count == 0) { <p>No decision reasons were recorded.</p> }
                else { <ul>@foreach (var reason in hostStats.Reasons) { <li>@CloudHostPrivacyReasonLabels.Describe(reason.ReasonCode): @reason.Count</li> }</ul> }
                <h3>Detected categories across host decisions</h3>
                @if (hostStats.Categories.Count == 0) { <p>No category counts were recorded.</p> }
                else { <ul>@foreach (var category in hostStats.Categories) { <li>@category.Category: @category.Count</li> }</ul> }
                <h3>Detected categories at the output boundary</h3>
                @if (hostStats.OutputCategories.Count == 0) { <p>No output category counts were recorded.</p> }
                else { <ul>@foreach (var category in hostStats.OutputCategories) { <li>@category.Category: @category.Count</li> }</ul> }
                <h3>Detected categories at other destinations</h3>
                @if (hostStats.OtherDestinationCategories.Count == 0) { <p>No category counts were recorded for other destinations.</p> }
                else { <ul>@foreach (var category in hostStats.OtherDestinationCategories) { <li>@category.Category: @category.Count</li> }</ul> }
            }
            @if (_hostPage.Observations.Count == 0) { <p>No host privacy reports were found.</p> }
            else
            {
                @foreach (var host in _hostPage.Observations)
                {
                    <article class="security-observation">
                        <h3>@(host.Allowed ? "Host firewall allowed" : "Host firewall blocked")</h3>
                        <dl>
                            <dt>Case ID</dt><dd><code>@host.EventId</code></dd>
                            <dt>Received at (UTC)</dt><dd>@host.ReceivedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                            <dt>Application ID</dt><dd><code>@host.ApplicationId</code></dd>
                            <dt>Destination</dt><dd>@host.Destination</dd>
                            <dt>Policy action</dt><dd>@host.Action</dd>
                            <dt>Reason</dt><dd>@CloudHostPrivacyReasonLabels.Describe(host.ReasonCode)</dd>
                            <dt>Detected categories</dt><dd>
                                @if (host.Categories.Count == 0) { <span>None recorded.</span> }
                                else { <ul>@foreach (var category in host.Categories) { <li>@category.Category: @category.Count</li> }</ul> }
                            </dd>
                        </dl>
                        <a href="@($"/cloud/tenants/{TenantId}/security/host-cases/{host.EventId}")">Review host case evidence</a>
                    </article>
                }
            }
            <nav aria-label="Host privacy report pages">
                <button class="button" type="button" disabled="@(!_interactive || _loading || _hostPageIndex == 0)" @onclick="PreviousHostAsync">Previous</button>
                <button class="button" type="button" disabled="@(!_interactive || _loading || _hostPage.Next is null)" @onclick="NextHostAsync">Next</button>
            </nav>
        </section>
    }
    @if (_evidencePage is not null)
    {
        <section aria-label="Structured security evidence events">
            <h2>Security evidence (openconnect.security-evidence.v1)</h2>
            <p>Content-free enforcement receipts recorded across PII, image privacy, malware, AI firewall, WAF, service fencing, and agent tools. No raw payloads or secrets are stored.</p>
            @if (_evidencePage.Events.Count == 0)
            {
                <p>No structured security evidence events have been recorded for this organization yet. Use the <a href="@($"/cloud/tenants/{TenantId}/security/playground")">Security Playground</a> or configure a connected host to record real enforcement events.</p>
            }
            else
            {
                @foreach (var ev in _evidencePage.Events)
                {
                    <article class="security-observation">
                        <h3>@ev.Capability — @ev.Decision (@ev.EnforcementOutcome)</h3>
                        <dl>
                            <dt>Event ID</dt><dd><code>@ev.EventId</code></dd>
                            <dt>Occurred at (UTC)</dt><dd>@ev.OccurredAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                            <dt>Boundary</dt><dd>@ev.Boundary</dd>
                            <dt>Detector</dt><dd>@ev.DetectorId (<code>@ev.DetectorVersion</code>)</dd>
                            <dt>Inspection status</dt><dd>@ev.InspectionStatus</dd>
                            <dt>Reason</dt><dd><code>@ev.ReasonCode</code></dd>
                            <dt>Duration</dt><dd>@ev.DurationMs ms</dd>
                            @if (!string.IsNullOrEmpty(ev.TraceId))
                            {
                                <dt>Trace ID</dt><dd><code>@ev.TraceId</code></dd>
                            }
                        </dl>
                    </article>
                }
            }
        </section>
    }
}
<p><a href="/cloud">Back to organizations</a></p>

@code {
    private const int PageSize = 20;
    [Parameter] public Guid TenantId { get; set; }
    private CloudPrivacyObservationPage? _page;
    private CloudPrivacyStatistics? _statistics;
    private CloudHostPrivacyObservationPage? _hostPage;
    private CloudAnalyticsPrivacyDashboard? _analytics;
    private CloudKnowledgeEmbeddingPrivacyDashboard? _embedding;
    private CloudSecurityEvidencePage? _evidencePage;
    private readonly List<CloudPrivacyObservationCursor?> _hostHistory = [null];
    private int _hostPageIndex;
    private readonly List<CloudPrivacyObservationCursor?> _history = [null];
    private int _pageIndex;
    private int _generation;
    private bool _loading = true, _interactive, _disposed;
    private string? _status;
    private string? _fromDate, _toDate;
    private DateTimeOffset? _from, _to;

    protected override void OnInitialized() => AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

    private void OnAuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            ++_generation;
            _page = null; _statistics = null; _hostPage = null; _analytics = null; _embedding = null; _evidencePage = null; _loading = false;
            _status = "Your identity changed. Reopen security observations to check access.";
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        ++_generation;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    protected override Task OnParametersSetAsync()
    {
        _fromDate = _toDate = null; _from = _to = null;
        _history.Clear(); _history.Add(null); _pageIndex = 0;
        _hostHistory.Clear(); _hostHistory.Add(null); _hostPageIndex = 0;
        return LoadAsync(null, 0);
    }

    protected override void OnAfterRender(bool firstRender) { if (firstRender) { _interactive = true; StateHasChanged(); } }

    private async Task ApplyDatesAsync()
    {
        if (!TryDate(_fromDate, out var from) || !TryDate(_toDate, out var through) ||
            through == DateOnly.MaxValue || from is not null && through is not null && from > through)
        { ++_generation; _page = null; _statistics = null; _hostPage = null; _analytics = null; _embedding = null; _loading = false; _status = "Enter a valid UTC date range."; return; }
        _from = from is null ? null : new DateTimeOffset(from.Value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc));
        _to = through is null ? null : new DateTimeOffset(through.Value.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc));
        _history.Clear(); _history.Add(null); _pageIndex = 0;
        await LoadAsync(null, 0);
    }

    private static bool TryDate(string? value, out DateOnly? result)
    {
        result = null;
        if (string.IsNullOrEmpty(value)) return true;
        if (!DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) return false;
        result = date; return true;
    }

    private Task PreviousAsync() => _pageIndex > 0 ? LoadAsync(_history[_pageIndex - 1], _pageIndex - 1) : Task.CompletedTask;
    private Task PreviousHostAsync()
    {
        if (_hostPageIndex == 0) return Task.CompletedTask;
        _hostPageIndex--;
        return LoadAsync(_history[_pageIndex], _pageIndex);
    }
    private Task NextHostAsync()
    {
        if (_hostPage?.Next is not { } next) return Task.CompletedTask;
        if (_hostHistory.Count > _hostPageIndex + 1) _hostHistory.RemoveRange(_hostPageIndex + 1, _hostHistory.Count - _hostPageIndex - 1);
        _hostHistory.Add(next); _hostPageIndex++;
        return LoadAsync(_history[_pageIndex], _pageIndex);
    }
    private Task NextAsync()
    {
        if (_page?.Next is not { } next) return Task.CompletedTask;
        if (_history.Count > _pageIndex + 1) _history.RemoveRange(_pageIndex + 1, _history.Count - _pageIndex - 1);
        _history.Add(next);
        return LoadAsync(next, _pageIndex + 1);
    }

    private async Task LoadAsync(CloudPrivacyObservationCursor? cursor, int pageIndex)
    {
        var generation = ++_generation; var tenantId = TenantId;
        _loading = true; _status = null; _page = null; _statistics = null; _hostPage = null; _analytics = null; _embedding = null; _evidencePage = null;
        try
        {
            var service = Services.GetService(typeof(CloudPrivacyObservationService)) as CloudPrivacyObservationService;
            var statisticsReader = Services.GetService(typeof(ICloudPrivacyStatisticsReader)) as ICloudPrivacyStatisticsReader;
            var hostReader = Services.GetService(typeof(ICloudHostPrivacyObservationReader)) as ICloudHostPrivacyObservationReader;
            var analyticsReader = Services.GetService(typeof(ICloudAnalyticsPrivacyReader)) as ICloudAnalyticsPrivacyReader;
            var embeddingReader = Services.GetService(typeof(ICloudKnowledgeEmbeddingPrivacyReader)) as ICloudKnowledgeEmbeddingPrivacyReader;
            var evidenceReader = Services.GetService(typeof(CloudSecurityEvidenceQueryService)) as CloudSecurityEvidenceQueryService;
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var identity = Configuration.GetSection("OpenConnect:Cloud:Identity");
            var subject = CloudIdentity.IsEnabled(authentication.User, identity)
                ? CloudSubjectResolver.FromPrincipal(authentication.User, identity["Authority"]) : null;
            CloudPrivacyObservationPage? page = null;
            CloudPrivacyStatistics? statistics = null;
            CloudHostPrivacyObservationPage? hostPage = null;
            CloudAnalyticsPrivacyDashboard? analytics = null;
            CloudKnowledgeEmbeddingPrivacyDashboard? embedding = null;
            CloudSecurityEvidencePage? evidencePage = null;
            string? status = null;
            if (service is null) status = "The Cloud control plane is not configured.";
            else if (subject is null) status = "The authenticated identity is missing a subject.";
            else
            {
                page = await service.GetTenantAsync(subject, tenantId, _from, _to, cursor, PageSize, CancellationToken.None);
                if (page is null) status = "The organization was not found or your role does not allow security access.";
                else if (statisticsReader is not null)
                    statistics = await statisticsReader.GetTenantAsync(subject, tenantId, _from, _to, CancellationToken.None);
                if (page is not null && hostReader is not null)
                    hostPage = await hostReader.GetTenantAsync(subject, tenantId, _hostHistory[_hostPageIndex], PageSize, CancellationToken.None);
                if (page is not null && analyticsReader is not null)
                    analytics = await analyticsReader.GetTenantAsync(subject, tenantId, CancellationToken.None);
                if (page is not null && embeddingReader is not null)
                    embedding = await embeddingReader.GetTenantAsync(subject, tenantId, CancellationToken.None);
                if (page is not null && evidenceReader is not null)
                    evidencePage = await evidenceReader.QueryTenantAsync(subject, tenantId, new CloudSecurityEvidenceFilter(FromUtc: _from, ToUtc: _to, Take: 25), CancellationToken.None);
            }
            if (generation != _generation) return;
            var currentAuthentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (generation != _generation) return;
            var currentSubject = CloudIdentity.IsEnabled(currentAuthentication.User, identity)
                ? CloudSubjectResolver.FromPrincipal(currentAuthentication.User, identity["Authority"]) : null;
            if (subject is null || currentSubject != subject) { page = null; statistics = null; hostPage = null; analytics = null; embedding = null; evidencePage = null; status = "The authenticated identity is no longer available."; }
            if (statisticsReader is not null && statistics is null && page is not null) { page = null; status = "The organization was not found or your role does not allow security access."; }
            if (hostReader is not null && hostPage is null && page is not null) { page = null; status = "The organization was not found or your role does not allow security access."; }
            if (analyticsReader is not null && analytics is null && page is not null) { page = null; status = "The organization was not found or your role does not allow security access."; }
            if (embeddingReader is not null && embedding is null && page is not null) { page = null; status = "The organization was not found or your role does not allow security access."; }
            _page = page; _statistics = statistics; _hostPage = page is null ? null : hostPage; _analytics = page is null ? null : analytics; _embedding = page is null ? null : embedding; _evidencePage = page is null ? null : evidencePage; _pageIndex = pageIndex; _status = status;
        }
        catch (Exception)
        {
            if (generation != _generation) return;
            Logger.LogWarning("Cloud security observation lookup failed.");
            _status = "Security observations are temporarily unavailable.";
        }
        finally { if (generation == _generation) _loading = false; }
    }

    private static string OutcomeLabel(string outcome) => outcome switch
    {
        "allowed" => "Cloud rules check passed",
        "privacy_blocked" => "Cloud privacy check blocked",
        "detector_unavailable" => "Cloud detector unavailable",
        _ => "Unknown Cloud decision",
    };

    private static string ActionLabel(string outcome) => outcome switch
    {
        "allowed" => "The Cloud privacy check allowed the request to proceed; worker execution is not confirmed.",
        "privacy_blocked" => "The Cloud privacy check blocked the request before worker dispatch.",
        "detector_unavailable" => "The Cloud privacy check could not complete; the request was not allowed to proceed.",
        _ => "The Cloud action is not known.",
    };
}
