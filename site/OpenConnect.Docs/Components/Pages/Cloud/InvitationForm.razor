@using OpenConnect.Docs.Cloud
@implements IDisposable
@inject IServiceProvider Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject ILogger<InvitationForm> Logger

<section aria-labelledby="invite-heading">
    <h2 id="invite-heading">Invite a member</h2>
    <p>Enter the person's subject from the configured identity provider. Share the resulting code through a trusted channel.</p>
    <label for="invite-subject">Identity provider subject</label>
    <input id="invite-subject" @bind="_subjectId" maxlength="1024" disabled="@(!Enabled || _busy)" />
    <label for="invite-role">Role</label>
    <select id="invite-role" @bind="_role" disabled="@(!Enabled || _busy)">
        <option>Developer</option><option>Administrator</option><option>SecurityAnalyst</option><option>BillingReader</option><option>Owner</option>
    </select>
    <button type="button" class="button primary" disabled="@(!Enabled || _busy)" @onclick="CreateAsync">Create invitation</button>
    @if (_status is not null) { <p role="status">@_status</p> }
    @if (_code is not null)
    {
        <h3>Save and share this code</h3>
        <p>It is shown only once and expires at @_expiresAt?.ToString("u"). The invited person enters it after signing in.</p>
        <code style="overflow-wrap:anywhere">@_code</code>
        <button type="button" class="button" @onclick="() => _code = null">Done</button>
    }
    <h3>Invitations</h3>
    @if (_listStatus is not null) { <p role="status">@_listStatus</p> }
    else if (_invitations.Count == 0) { <p>No invitations have been issued.</p> }
    else
    {
        <ul class="cloud-list">
            @foreach (var invitation in _invitations)
            {
                <li>
                    <strong>@invitation.SubjectId</strong><span>@invitation.Role · @InvitationStatus(invitation)</span>
                    <span>Expires: @invitation.ExpiresAt.ToString("u")</span>
                    @if (invitation.AcceptedAt is null && invitation.RevokedAt is null && invitation.ExpiresAt > DateTimeOffset.UtcNow)
                    {
                        @if (_confirmRevoke == invitation.Id)
                        {
                            <span>Revoke this invitation?</span>
                            <button type="button" class="button" aria-label="@($"Confirm revocation for {invitation.SubjectId}")" disabled="@(!Enabled || _busy)" @onclick="() => RevokeAsync(invitation)">Confirm revocation</button>
                            <button type="button" class="button" disabled="@_busy" @onclick="() => _confirmRevoke = null">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="button" aria-label="@($"Revoke invitation for {invitation.SubjectId}")" disabled="@(!Enabled || _busy)" @onclick="() => _confirmRevoke = invitation.Id">Revoke</button>
                        }
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public bool Enabled { get; set; }
    private string? _subjectId;
    private string _role = "Developer";
    private string? _code;
    private string? _status;
    private DateTimeOffset? _expiresAt;
    private bool _busy;
    private int _generation;
    private Guid? _currentTenantId;
    private Guid? _confirmRevoke;
    private string? _listStatus = "Loading invitations…";
    private IReadOnlyList<CloudInvitationSummary> _invitations = [];

    protected override async Task OnParametersSetAsync()
    {
        if (_currentTenantId == TenantId) return;
        _currentTenantId = TenantId;
        _generation++; _code = null; _status = null; _subjectId = null; _role = "Developer";
        _confirmRevoke = null; _invitations = [];
        await ReloadAsync(_generation);
    }

    public void Dispose() { _generation++; _code = null; }

    private async Task CreateAsync()
    {
        var generation = _generation;
        var tenantId = TenantId;
        var subjectId = _subjectId;
        var role = _role;
        _busy = true; _status = null; _code = null;
        try
        {
            var service = Services.GetService(typeof(CloudInvitationService)) as CloudInvitationService;
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (generation != _generation) return;
            var issuer = Configuration["OpenConnect:Cloud:Identity:Authority"];
            var actor = CloudSubjectResolver.FromPrincipal(authentication.User, issuer);
            if (service is null || actor is null) { _status = "Invitation service is unavailable."; return; }
            var result = await service.CreateAsync(actor, tenantId, new CreateCloudInvitationRequest(issuer, subjectId, role), CancellationToken.None);
            if (generation != _generation) return;
            if (result.Status == "succeeded") { _code = result.Code; _expiresAt = result.ExpiresAt; await ReloadAsync(generation); }
            else _status = result.Status switch
            {
                "invalid_request" => "Enter a valid identity subject and role.",
                "already_member" => "This identity is already a member.",
                "reinvitation_unavailable" => "A previous membership must be reconciled before reinvitation.",
                _ => "The invitation was not created. Check your access and try again.",
            };
        }
        catch (Exception) { Logger.LogWarning("Cloud invitation creation failed."); if (generation == _generation) _status = "The invitation was not confirmed. Try again."; }
        finally { if (generation == _generation) _busy = false; }
    }

    private async Task ReloadAsync(int generation)
    {
        _listStatus = "Loading invitations…";
        try
        {
            var service = Services.GetService(typeof(CloudInvitationService)) as CloudInvitationService;
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (generation != _generation) return;
            var actor = CloudSubjectResolver.FromPrincipal(principal, Configuration["OpenConnect:Cloud:Identity:Authority"]);
            if (service is null || actor is null) { _listStatus = "Invitations are unavailable."; return; }
            var invitations = await service.ListAsync(actor, TenantId, CancellationToken.None);
            if (generation != _generation) return;
            if (invitations is null) { _listStatus = "Invitations are unavailable."; return; }
            _invitations = invitations;
            _listStatus = null;
        }
        catch (Exception) { Logger.LogWarning("Cloud invitation lookup failed."); if (generation == _generation) _listStatus = "Invitations could not be loaded."; }
    }

    private async Task RevokeAsync(CloudInvitationSummary invitation)
    {
        var generation = _generation;
        var tenantId = TenantId;
        _busy = true; _status = null;
        try
        {
            var service = Services.GetService(typeof(CloudInvitationService)) as CloudInvitationService;
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (generation != _generation) return;
            var actor = CloudSubjectResolver.FromPrincipal(principal, Configuration["OpenConnect:Cloud:Identity:Authority"]);
            if (service is null || actor is null) { _status = "Invitation service is unavailable."; return; }
            var result = await service.RevokeAsync(actor, tenantId, invitation.Id, invitation.Revision, CancellationToken.None);
            if (generation != _generation) return;
            _confirmRevoke = null;
            await ReloadAsync(generation);
            if (generation == _generation) _status = result.Status == "succeeded" ? "Invitation revoked." : "The invitation was not revoked. Review its latest status.";
        }
        catch (Exception) { Logger.LogWarning("Cloud invitation revocation failed."); if (generation == _generation) _status = "Revocation was not confirmed. Reload before retrying."; }
        finally { if (generation == _generation) _busy = false; }
    }

    private static string InvitationStatus(CloudInvitationSummary invitation) => invitation.RevokedAt is not null ? "Revoked" :
        invitation.AcceptedAt is not null ? "Accepted" : invitation.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired" : "Pending";
}
