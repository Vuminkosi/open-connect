@page "/cloud/tenants/{TenantId:guid}/usage"
@attribute [Authorize]
@layout Layout.CloudLayout
@rendermode InteractiveServer
@using System.Globalization
@using OpenConnect.Docs.Cloud
@inject IServiceProvider Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject ILogger<TenantUsage> Logger

<PageTitle>Usage | OpenConnect Cloud</PageTitle>
<h1>Recorded usage</h1>
<p>These are finalized quota ledger entries, including zero-quantity releases. They are not invoices or prices, and do not include unfinalized reservations or all provider usage. Times are in UTC.</p>
<div class="security-filter">
    <label for="usage-from">From date (UTC)</label><input id="usage-from" type="date" value="@_fromDate" @onchange="e => _fromDate = e.Value?.ToString()" disabled="@(!_interactive || _loading)" />
    <label for="usage-to">Through date (UTC)</label><input id="usage-to" type="date" value="@_toDate" @onchange="e => _toDate = e.Value?.ToString()" disabled="@(!_interactive || _loading)" />
    <button class="button" type="button" disabled="@(!_interactive || _loading)" @onclick="ApplyDatesAsync">Apply dates</button>
</div>
@if (_loading) { <p role="status">Loading usage records...</p> }
else if (_status is not null) { <p role="status">@_status</p> }
else if (_page is not null)
{
    <section aria-labelledby="usage-summary-title">
        <h2 id="usage-summary-title">Daily breakdown</h2>
        <p>Totals reflect finalized ledger quantities for each application, service and unit. Zero-quantity releases are included in the record count.</p>
        @if (_summaryStatus is not null) { <p role="status">@_summaryStatus</p> }
        else if (_summary is null) { <p>Select a date range of at most 93 days to see the breakdown.</p> }
        else if (_summary.LimitExceeded) { <p>There are too many groups to display. Select a shorter date range.</p> }
        else if (_summary.Totals.Count == 0) { <p>No finalized usage was recorded for this period.</p> }
        else
        {
            <div class="cloud-capabilities">
                @foreach (var total in _summary.Totals)
                {
                    <article class="quota-card">
                        <h3>@(total.CapabilityId ?? "Unknown capability")</h3>
                        <dl>
                            <dt>Date (UTC)</dt><dd>@total.DayUtc.ToString("yyyy-MM-dd")</dd>
                            <dt>Application ID</dt><dd><code>@total.ApplicationId</code></dd>
                            <dt>Quantity</dt><dd>@total.Quantity @(total.Unit ?? "unknown unit")</dd>
                            <dt>Ledger records</dt><dd>@total.Records</dd>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>
    <h2>Ledger entries</h2>
    @if (_page.Entries.Count == 0) { <p>No recorded usage was found for this period.</p> }
    else
    {
        <div class="cloud-capabilities">
            @foreach (var entry in _page.Entries)
            {
                <article class="quota-card">
                    <h2>@(entry.CapabilityId ?? "Unknown capability")</h2>
                    <dl>
                        <dt>Recorded at (UTC)</dt><dd>@entry.RecordedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt>Application ID</dt><dd><code>@entry.ApplicationId</code></dd>
                        <dt>Quantity</dt><dd>@entry.Quantity @(entry.Unit ?? "unknown unit")</dd>
                        <dt>Provenance</dt><dd>@entry.Provenance</dd>
                        <dt>Request ID</dt><dd><code>@entry.RequestId</code></dd>
                    </dl>
                </article>
            }
        </div>
    }
    @if (_from is not null && _to is not null && _to.Value - _from.Value <= TimeSpan.FromDays(93))
    {
        <p><a href="@ExportUrl">Download CSV for this date range</a> (up to 10,000 records).</p>
    }
    else
    {
        <p>Select a date range of at most 93 days to download up to 10,000 records as CSV.</p>
    }
    <nav aria-label="Usage record pages">
        <button class="button" type="button" disabled="@(!_interactive || _loading || _pageIndex == 0)" @onclick="PreviousAsync">Previous</button>
        <button class="button" type="button" disabled="@(!_interactive || _loading || _page.Next is null)" @onclick="NextAsync">Next</button>
    </nav>
}
<p><a href="/cloud">Back to organizations</a></p>

@code {
    private const int PageSize = 20;
    [Parameter] public Guid TenantId { get; set; }
    private CloudUsagePage? _page;
    private CloudUsageSummary? _summary;
    private string? _summaryStatus;
    private readonly List<CloudUsageCursor?> _history = [null];
    private int _pageIndex, _generation;
    private bool _loading = true, _interactive;
    private string? _status, _fromDate, _toDate;
    private DateTimeOffset? _from, _to;
    private string ExportUrl => $"/cloud/api/v1/tenants/{TenantId:D}/usage/export?from={Uri.EscapeDataString(_from!.Value.ToString("O"))}&to={Uri.EscapeDataString(_to!.Value.ToString("O"))}";

    protected override Task OnParametersSetAsync()
    {
        _fromDate = _toDate = null; _from = _to = null;
        _history.Clear(); _history.Add(null); _pageIndex = 0;
        return LoadAsync(null, 0);
    }

    protected override void OnAfterRender(bool firstRender) { if (firstRender) { _interactive = true; StateHasChanged(); } }

    private async Task ApplyDatesAsync()
    {
        if (!TryDate(_fromDate, out var from) || !TryDate(_toDate, out var through) ||
            through == DateOnly.MaxValue || from is not null && through is not null && from > through)
        { _page = null; _status = "Enter a valid UTC date range."; return; }
        _from = from is null ? null : new DateTimeOffset(from.Value.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc));
        _to = through is null ? null : new DateTimeOffset(through.Value.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc));
        _history.Clear(); _history.Add(null); _pageIndex = 0;
        await LoadAsync(null, 0);
    }

    private static bool TryDate(string? value, out DateOnly? result)
    {
        result = null;
        if (string.IsNullOrEmpty(value)) return true;
        if (!DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) return false;
        result = date; return true;
    }

    private Task PreviousAsync() => _pageIndex > 0 ? LoadAsync(_history[_pageIndex - 1], _pageIndex - 1) : Task.CompletedTask;
    private Task NextAsync()
    {
        if (_page?.Next is not { } next) return Task.CompletedTask;
        if (_history.Count > _pageIndex + 1) _history.RemoveRange(_pageIndex + 1, _history.Count - _pageIndex - 1);
        _history.Add(next);
        return LoadAsync(next, _pageIndex + 1);
    }

    private async Task LoadAsync(CloudUsageCursor? cursor, int pageIndex)
    {
        var generation = ++_generation; var tenantId = TenantId;
        _loading = true; _status = null; _page = null; _summary = null; _summaryStatus = null;
        try
        {
            var service = Services.GetService(typeof(CloudUsageQueryService)) as CloudUsageQueryService;
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var identity = Configuration.GetSection("OpenConnect:Cloud:Identity");
            var subject = CloudIdentity.IsEnabled(authentication.User, identity)
                ? CloudSubjectResolver.FromPrincipal(authentication.User, identity["Authority"]) : null;
            CloudUsagePage? page = null; string? status = null;
            if (service is null) status = "The Cloud control plane is not configured.";
            else if (subject is null) status = "The authenticated identity is missing a subject.";
            else
            {
                page = await service.GetTenantAsync(subject, tenantId, _from, _to, cursor, PageSize, CancellationToken.None);
                if (page is null) status = "The organization was not found or your role does not allow usage access.";
            }
            CloudUsageSummary? summary = null; string? summaryStatus = null;
            if (page is not null && subject is not null && _from is not null && _to is not null && _to.Value - _from.Value <= TimeSpan.FromDays(93))
            {
                try
                {
                    var summaries = Services.GetService(typeof(CloudUsageSummaryService)) as CloudUsageSummaryService;
                    if (summaries is null) summaryStatus = "Daily breakdown is unavailable.";
                    else
                    {
                        summary = await summaries.GetTenantAsync(subject, tenantId, _from.Value, _to.Value, CancellationToken.None);
                        if (summary is null) { page = null; status = "The organization was not found or your role does not allow usage access."; }
                    }
                }
                catch (Exception) { Logger.LogWarning("Cloud usage summary lookup failed."); summaryStatus = "Daily breakdown is temporarily unavailable."; }
            }
            if (generation != _generation) return;
            if (!CloudIdentity.IsEnabled(authentication.User, identity)) { page = null; summary = null; status = "The authenticated identity is no longer available."; }
            _page = page; _pageIndex = pageIndex; _status = status; _summary = summary; _summaryStatus = summaryStatus;
        }
        catch (Exception)
        {
            if (generation != _generation) return;
            Logger.LogWarning("Cloud usage lookup failed.");
            _status = "Usage records are temporarily unavailable.";
        }
        finally { if (generation == _generation) _loading = false; }
    }
}
