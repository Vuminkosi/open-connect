{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/document-fields-response.json",
  "title": "Document fields response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "kind",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "openconnect.v1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "const": "documents.fields"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "fields",
        "warnings"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "width",
              "height",
              "spans",
              "model_id",
              "model_fingerprint",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "model_fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "language": {
                "const": "eng"
              },
              "spans": {
                "type": "array",
                "maxItems": 50000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "start",
                    "end",
                    "box",
                    "confidence"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "box": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "fields": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page_index",
              "label",
              "value",
              "label_start",
              "value_start",
              "label_end",
              "value_end",
              "label_span_indexes",
              "value_span_indexes",
              "minimum_ocr_confidence"
            ],
            "properties": {
              "page_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 29
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "label_start": {
                "type": "integer",
                "minimum": 0
              },
              "value_start": {
                "type": "integer",
                "minimum": 0
              },
              "label_end": {
                "type": "integer",
                "minimum": 1
              },
              "value_end": {
                "type": "integer",
                "minimum": 1
              },
              "label_span_indexes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50000,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49999
                }
              },
              "value_span_indexes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50000,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49999
                }
              },
              "minimum_ocr_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "field_candidates_skipped",
              "field_limit_reached"
            ]
          }
        }
      }
    }
  }
}
