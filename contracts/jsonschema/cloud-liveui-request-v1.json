{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/cloud/liveui-request-v1.json",
  "title": "OpenConnect Cloud LiveUI planning request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "capability", "expiresAt", "input"],
  "properties": {
    "schemaVersion": {"const": "openconnect.cloud.liveui/v1"},
    "requestId": {"type": "string", "pattern": "^(?!00000000-0000-0000-0000-000000000000)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "capability": {"const": "inference.liveui"},
    "expiresAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "intent", "context", "generation"],
      "properties": {
        "schemaVersion": {"type": "string", "minLength": 1, "maxLength": 32},
        "intent": {"type": "string", "minLength": 1, "maxLength": 8000},
        "context": {
          "type": "object", "additionalProperties": false, "required": ["route", "availableActions"],
          "properties": {
            "route": {"type": "string", "minLength": 1, "maxLength": 256},
            "availableActions": {"type": "array", "maxItems": 256, "items": {
              "type": "object", "additionalProperties": false, "required": ["target", "action"],
              "properties": {"target": {"type": "string", "minLength": 1, "maxLength": 256},
                "action": {"type": "string", "minLength": 1, "maxLength": 32},
                "label": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 256}, {"type": "null"}]}}
            }}
          }
        },
        "generation": {
          "type": "object", "additionalProperties": false, "required": ["maxActions", "maxOutputTokens"],
          "properties": {"maxActions": {"type": "integer", "minimum": 1, "maximum": 32},
            "maxOutputTokens": {"type": "integer", "minimum": 16, "maximum": 512}}
        }
      }
    }
  }
}
