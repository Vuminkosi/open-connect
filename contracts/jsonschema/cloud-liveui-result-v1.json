{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/cloud/liveui-result-v1.json",
  "title": "OpenConnect Cloud LiveUI planning result",
  "description": "An untrusted proposal. The application host must revalidate and authorize each action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "traceId", "provider", "plan"],
  "properties": {
    "schemaVersion": {"const": "openconnect.cloud.liveui.result/v1"},
    "requestId": {"type": "string", "pattern": "^(?!00000000-0000-0000-0000-000000000000)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "traceId": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
    "provider": {"enum": ["deterministic", "qwen3-0.6b"]},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "actions"],
      "properties": {
        "schemaVersion": {"type": "string", "minLength": 1, "maxLength": 32},
        "actions": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "target"],
            "properties": {
              "type": {"enum": ["activate", "navigate", "setValue", "select", "highlight", "focus", "scroll", "inspect"]},
              "target": {"type": "string", "minLength": 1, "maxLength": 256},
              "value": {"type": "string", "maxLength": 256}
            },
            "allOf": [
              {"if": {"properties": {"type": {"enum": ["setValue", "select"]}}, "required": ["type"]},
               "then": {"required": ["value"]}, "else": {"not": {"required": ["value"]}}}
            ]
          }
        }
      }
    }
  }
}
