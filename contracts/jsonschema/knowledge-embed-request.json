{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/knowledge-embed-request.json",
  "title": "Knowledge embedding request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "kind", "tenantId", "issuedAt", "expiresAt", "payload"],
  "properties": {
    "schemaVersion": {"const": "openconnect.v1"},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "knowledge.embed"},
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object", "additionalProperties": false, "required": ["inputKind", "texts"],
      "properties": {
        "inputKind": {"enum": ["query", "passage"]},
        "texts": {"type": "array", "minItems": 1, "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 8192}}
      }
    }
  }
}
