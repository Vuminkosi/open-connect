{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/documents-extract-request.json",
  "title": "Structured extraction request", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "kind", "tenantId", "issuedAt", "expiresAt", "payload"],
  "properties": {
    "schemaVersion": {"const": "openconnect.v1"}, "taskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "documents.extract"},
    "tenantId": {"type": "string", "minLength": 26, "maxLength": 26, "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["document", "extractionSchema"],
      "properties": {"document": {"type": "string", "minLength": 1, "maxLength": 100000},
                     "extractionSchema": {"$ref": "#/$defs/extractionSchema"}}}
  },
  "$defs": {
    "extractionSchema": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "properties", "additionalProperties"],
      "properties": {
        "type": {"const": "object"},
        "additionalProperties": {"const": false},
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "properties": {
          "type": "object", "minProperties": 1, "maxProperties": 32,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
          "additionalProperties": {"$ref": "#/$defs/field"}
        }
      }
    },
    "field": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"oneOf": [
          {"enum": ["string", "integer", "number", "boolean"]},
          {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
           "items": {"enum": ["string", "integer", "number", "boolean", "null"]},
           "contains": {"enum": ["string", "integer", "number", "boolean"]},
           "if": {"minItems": 2}, "then": {"contains": {"const": "null"}}}
        ]},
        "minimum": {"type": ["number", "null"], "minimum": -1e100, "maximum": 1e100},
        "maximum": {"type": ["number", "null"], "minimum": -1e100, "maximum": 1e100},
        "minLength": {"type": ["integer", "null"], "minimum": 0, "maximum": 8192},
        "maxLength": {"type": ["integer", "null"], "minimum": 0, "maximum": 8192},
        "enum": {"type": ["array", "null"], "minItems": 1, "maxItems": 64}
      }
    }
  }
}
