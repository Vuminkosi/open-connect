{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/document-tables-response.json",
  "title": "Document table candidate response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "kind",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "openconnect.v1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "const": "documents.tables"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "tables",
        "warnings"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "width",
              "height",
              "spans",
              "model_id",
              "model_fingerprint",
              "language"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "model_fingerprint": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              },
              "language": {
                "const": "eng"
              },
              "spans": {
                "type": "array",
                "maxItems": 50000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "start",
                    "end",
                    "box",
                    "confidence"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "box": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "line_limit_reached",
              "heuristic_tables_require_review",
              "table_limit_reached"
            ]
          }
        },
        "tables": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page_index",
              "rows",
              "columns",
              "cells"
            ],
            "properties": {
              "page_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 29
              },
              "rows": {
                "type": "integer",
                "minimum": 2,
                "maximum": 50000
              },
              "columns": {
                "type": "integer",
                "minimum": 2,
                "maximum": 20
              },
              "cells": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "row",
                    "column",
                    "start",
                    "end",
                    "span_indexes",
                    "box",
                    "minimum_ocr_confidence"
                  ],
                  "properties": {
                    "row": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 49999
                    },
                    "column": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 19
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "span_indexes": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 50000,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 49999
                      }
                    },
                    "box": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "minimum_ocr_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "minItems": 4
              }
            }
          }
        }
      }
    }
  }
}
