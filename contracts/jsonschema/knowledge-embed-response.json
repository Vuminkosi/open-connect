{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/knowledge-embed-response.json",
  "title": "Knowledge embedding response",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "kind", "result"],
  "properties": {
    "schemaVersion": {"const": "openconnect.v1"},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "knowledge.embed"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "model_id", "fingerprint", "dimension", "space_id"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "space_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dimension": {"type": "integer", "minimum": 1, "maximum": 8192},
        "items": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["vector", "truncated", "norm"],
          "properties": {
            "vector": {"type": "array", "minItems": 1, "maxItems": 8192,
              "items": {"type": "number"}},
            "truncated": {"type": "boolean"},
            "norm": {"type": "number", "minimum": 0}
          }
        }}
      }
    }
  }
}
