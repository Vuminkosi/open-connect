{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/cloud/voice-synthesis-result-v1.json",
  "title": "OpenConnect Cloud speech synthesis result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "traceId", "result"],
  "properties": {
    "schemaVersion": {"const": "openconnect.cloud.voice-synthesis.result/v1"},
    "requestId": {"type": "string", "pattern": "^(?!00000000-0000-0000-0000-000000000000)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "traceId": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "sampleRateHz", "channels", "voiceId", "locale", "audioBase64"],
      "properties": {
        "format": {"enum": ["wav", "pcm"]},
        "sampleRateHz": {"const": 24000},
        "channels": {"const": 1},
        "voiceId": {"const": "af_heart"},
        "locale": {"type": "string", "minLength": 1, "maxLength": 16},
        "audioBase64": {"type": "string", "minLength": 4, "maxLength": 7680060, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }
    }
  }
}
