{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/knowledge-rerank-request.json",
  "title": "Knowledge rerank request",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "kind", "tenantId", "issuedAt", "expiresAt", "payload"],
  "properties": {
    "schemaVersion": {"const": "openconnect.v1"},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "knowledge.rerank"},
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["query", "candidates"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 8192},
        "candidates": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "text"],
          "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
                         "text": {"type": "string", "minLength": 1, "maxLength": 8192}}
        }}
      }
    }
  }
}
