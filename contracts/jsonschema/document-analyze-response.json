{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/document-analyze-response.json",
  "title": "Document analysis response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "kind",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "openconnect.v1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "const": "documents.analyze"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "layout",
        "tables",
        "fields",
        "status",
        "warnings"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page_index",
              "status",
              "page",
              "reason"
            ],
            "properties": {
              "page_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 29
              },
              "status": {
                "enum": [
                  "completed",
                  "failed"
                ]
              },
              "page": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "width",
                      "height",
                      "spans",
                      "model_id",
                      "model_fingerprint",
                      "language"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "model_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "model_fingerprint": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "language": {
                        "const": "eng"
                      },
                      "spans": {
                        "type": "array",
                        "maxItems": 50000,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "text",
                            "start",
                            "end",
                            "box",
                            "confidence"
                          ],
                          "properties": {
                            "text": {
                              "type": "string",
                              "minLength": 1
                            },
                            "start": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "box": {
                              "type": "array",
                              "minItems": 4,
                              "maxItems": 4,
                              "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            },
                            "confidence": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "enum": [
                  null,
                  "page_unavailable",
                  "ocr_unavailable",
                  "deadline_exceeded"
                ]
              }
            },
            "oneOf": [
              {
                "properties": {
                  "status": {
                    "const": "completed"
                  },
                  "page": {
                    "type": "object"
                  },
                  "reason": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "status": {
                    "const": "failed"
                  },
                  "page": {
                    "type": "null"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items",
            "warnings"
          ],
          "properties": {
            "status": {
              "enum": [
                "completed",
                "partial",
                "unavailable"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 50000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "page_index",
                  "start",
                  "end",
                  "span_indexes",
                  "box",
                  "minimum_ocr_confidence"
                ],
                "properties": {
                  "page_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 29
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "span_indexes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50000,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 49999
                    }
                  },
                  "box": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "minimum_ocr_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 8,
              "items": {
                "enum": [
                  "line_limit_reached",
                  "table_limit_reached",
                  "heuristic_tables_require_review",
                  "field_candidates_skipped",
                  "field_limit_reached",
                  "component_unavailable",
                  "no_completed_pages"
                ]
              }
            }
          }
        },
        "tables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items",
            "warnings"
          ],
          "properties": {
            "status": {
              "enum": [
                "completed",
                "partial",
                "unavailable"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "page_index",
                  "rows",
                  "columns",
                  "cells"
                ],
                "properties": {
                  "page_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 29
                  },
                  "rows": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 50000
                  },
                  "columns": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 20
                  },
                  "cells": {
                    "type": "array",
                    "maxItems": 10000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "row",
                        "column",
                        "start",
                        "end",
                        "span_indexes",
                        "box",
                        "minimum_ocr_confidence"
                      ],
                      "properties": {
                        "row": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 49999
                        },
                        "column": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 19
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "span_indexes": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 50000,
                          "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 49999
                          }
                        },
                        "box": {
                          "type": "array",
                          "minItems": 4,
                          "maxItems": 4,
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "minimum_ocr_confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    "minItems": 4
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 8,
              "items": {
                "enum": [
                  "line_limit_reached",
                  "table_limit_reached",
                  "heuristic_tables_require_review",
                  "field_candidates_skipped",
                  "field_limit_reached",
                  "component_unavailable",
                  "no_completed_pages"
                ]
              }
            }
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "items",
            "warnings"
          ],
          "properties": {
            "status": {
              "enum": [
                "completed",
                "partial",
                "unavailable"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "page_index",
                  "label",
                  "value",
                  "label_start",
                  "value_start",
                  "label_end",
                  "value_end",
                  "label_span_indexes",
                  "value_span_indexes",
                  "minimum_ocr_confidence"
                ],
                "properties": {
                  "page_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 29
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "label_start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "value_start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "label_end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "value_end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "label_span_indexes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50000,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 49999
                    }
                  },
                  "value_span_indexes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50000,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 49999
                    }
                  },
                  "minimum_ocr_confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 8,
              "items": {
                "enum": [
                  "line_limit_reached",
                  "table_limit_reached",
                  "heuristic_tables_require_review",
                  "field_candidates_skipped",
                  "field_limit_reached",
                  "component_unavailable",
                  "no_completed_pages"
                ]
              }
            }
          }
        },
        "status": {
          "enum": [
            "completed",
            "partial"
          ]
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "heuristic_candidates_require_review",
              "component_results_incomplete",
              "page_results_incomplete"
            ]
          }
        }
      }
    }
  }
}
