{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/knowledge-rerank-response.json",
  "title": "Knowledge rerank response",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "kind", "result"],
  "properties": {
    "schemaVersion": {"const": "openconnect.v1"},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "knowledge.rerank"},
    "result": {"type": "object", "additionalProperties": false,
      "required": ["candidates", "model_id", "fingerprint", "score_type"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
        "fingerprint": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
        "score_type": {"const": "raw_logit"},
        "candidates": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "score"],
          "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
                         "score": {"type": "number"}}
        }}
      }
    }
  }
}
