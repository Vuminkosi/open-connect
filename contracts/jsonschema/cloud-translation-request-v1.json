{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/cloud/translation-request-v1.json",
  "title": "OpenConnect Cloud translation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "capability", "expiresAt", "input"],
  "properties": {
    "schemaVersion": {"const": "openconnect.cloud.translation/v1"},
    "requestId": {"type": "string", "pattern": "^(?!00000000-0000-0000-0000-000000000000)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "capability": {"const": "translation.translate"},
    "expiresAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "sourceLang", "targetLang"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S"},
        "sourceLang": {"type": "string", "pattern": "^[a-z]{3}_[A-Z][a-z]{3}$"},
        "targetLang": {"type": "string", "pattern": "^[a-z]{3}_[A-Z][a-z]{3}$"}
      }
    }
  }
}
