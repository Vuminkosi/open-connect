{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/cloud-knowledge-embed-response-v1.json",
  "title": "Cloud knowledge embedding response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "traceId", "result"],
  "properties": {
    "schemaVersion": {"const": "openconnect.cloud.knowledge-embed.result/v1"},
    "requestId": {"type": "string", "pattern": "^(?!00000000-0000-0000-0000-000000000000)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "model_id", "fingerprint", "dimension", "space_id"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$", "allOf": [{"pattern": "\\S"}]},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "space_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dimension": {"type": "integer", "minimum": 1, "maximum": 8192},
        "items": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["vector", "truncated", "norm"],
          "properties": {
            "vector": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"type": "number", "minimum": -1.001, "maximum": 1.001}},
            "truncated": {"type": "boolean"},
            "norm": {"type": "number", "minimum": 0}
          }
        }}
      }
    }
  }
}
