{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openconnect.dev/contracts/openconnect.v1/document-ocr-response.json",
  "title": "Document OCR response",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "kind", "result"],
  "properties": {
    "schemaVersion": {"const": "openconnect.v1"},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "documents.ocr"},
    "result": {"type": "object", "additionalProperties": false, "required": ["pages"],
      "properties": {"pages": {"type": "array", "minItems": 1, "maxItems": 30, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "width", "height", "spans", "model_id", "model_fingerprint", "language"],
        "properties": {
          "text": {"type": "string"}, "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "model_id": {"type": "string", "minLength": 1},
          "model_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "language": {"const": "eng"},
          "spans": {"type": "array", "maxItems": 50000, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["text", "start", "end", "box", "confidence"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1},
              "box": {"type": "array", "minItems": 4, "maxItems": 4,
                      "items": {"type": "number", "minimum": 0, "maximum": 1}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }}
        }
      }}}
    }
  }
}
