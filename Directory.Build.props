<Project>
  <!-- Anchored import: shared TFM list for multi-targeted libraries (CF-IMP-003). -->
  <Import Project="$(MSBuildThisFileDirectory)build/supported-frameworks.props" />

  <PropertyGroup>
    <!--
      Default single TFM for executables, samples, and tests that do not opt in.
      It is intentionally NOT set for projects under src/: shippable libraries
      MUST use the plural form instead, and a non-empty singular TargetFramework
      would suppress plural dispatch (only the singular TFM would build).
      Libraries opt in with:
        <TargetFrameworks>$(OpenConnectLibraryTargetFrameworks)</TargetFrameworks>
      Never set a global plural TargetFrameworks here: executables stay single-target.
    -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and !$(MSBuildProjectDirectory.Contains('\src\')) and !$(MSBuildProjectDirectory.Contains('/src/'))">net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      NU1902 (OC-G5-FIX02, supersedes OC-G5-FIX01): GHSA-23fw (CVSS 5.9M) in
      transitive Microsoft.Build.Tasks.Git 8.0.0 is FIXED in the 10.0.1xx line
      (>=10.0.111): Microsoft.SourceLink.GitHub 10.0.403 (SDK-aligned with
      global.json 10.0.403, verified live on nuget.org) pulls a fixed
      transitive. The dependency remains build-time-only (PrivateAssets=all:
      never ships in any .nupkg/.snupkg). Locked restore and Release pack now
      emit zero NU1902; the entry below is retained only so future
      build-time-only advisory noise cannot fail Release packs. Flagged for
      dependency-auditor review before any removal.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Central lockfiles (CF-REQ-021): reproducible restores solution-wide. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'OpenConnect' and !$(MSBuildProjectName.Contains('Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package README (OC-README-SLICE): embed each library's README.md as the
       NuGet package readme. Exists-guarded so non-library projects (tests,
       samples) and libraries without a README are unaffected. Additive only. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- SourceLink (OC-G5-FIX02): repo-embedded debugging for shippable libs.
       Version pinned in Directory.Packages.props (10.0.403, SDK-aligned,
       verified on nuget.org). PrivateAssets=all: build-time only, never
       flows to consumers. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
