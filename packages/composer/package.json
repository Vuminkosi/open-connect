{
  "name": "@openconnect/composer",
  "version": "0.1.0",
  "description": "Framework-neutral browser mini-composer (FAB + anchored bubble) for the OpenConnect v1 HTTP contract. SSR-safe; DOM is touched only on mount.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openconnect/client": "file:../client-ts",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
