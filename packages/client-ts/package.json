{
  "name": "@openconnect/client",
  "version": "0.1.0",
  "description": "Fetch-based TypeScript SDK for the OpenConnect v1 HTTP contract (browser + Node). No NATS exposure.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
