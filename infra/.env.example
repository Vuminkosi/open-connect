# Local infrastructure and application configuration template.
# Copy to .env for local use; never commit .env or place real credentials here.

# PostgreSQL
POSTGRES_DB=openconnect
POSTGRES_USER=openconnect
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5874
# Host connections use the published port; containers on the Compose network use 5432.
ConnectionStrings__OpenConnect=Host=localhost;Port=${POSTGRES_PORT:-5874};Database=openconnect;Username=openconnect;Password=change-me

# Qdrant: set QDRANT_IMAGE to the v1.19.0 reference with its verified sha256 digest.
QDRANT_IMAGE=qdrant/qdrant:v1.19.0@sha256:replace-with-verified-digest
QDRANT_API_KEY=

# NATS: provide distinct local credentials; no credentials are committed.
NATS_APP_USER=openconnect
NATS_APP_PASSWORD=
NATS_BOOTSTRAP_USER=openconnect-bootstrap
NATS_BOOTSTRAP_PASSWORD=
NATS_CLIENT_PORT=4332
NATS_MONITOR_PORT=8322
NATS_URL=nats://nats:4222
NATS_NOTIFICATION_STREAM=OC_NOTIFICATIONS
NATS_NOTIFICATION_SUBJECT=oc.v1.notifications.inapp
NATS_INGESTION_STREAM=OC_INGESTION
NATS_INGESTION_SUBJECT=oc.v1.ingestion.>
# Optional NATS CLI options file inside bootstrap container; absent/nonexistent is skipped.
OPENCONNECT_NATS_OPTIONS_FILE=

# Local security scanner token. Replace only in your untracked local .env.
OPENCONNECT_SCAN_TOKEN=replace-me

# ASP.NET Core and optional OpenTelemetry
ASPNETCORE_ENVIRONMENT=Development
OTEL_SERVICE_NAME=OpenConnect
OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenConnect model configuration
OpenConnect__ApiKey=
OpenConnect__ApiUrl=
OpenConnect__ReasoningModel=
OpenConnect__ReasoningBackend=meta
OpenConnect__Reasoning__Ollama__Endpoint=http://localhost:11434
OpenConnect__Reasoning__Ollama__Model=llama3.2:3b
# Keep serverless disabled until the Meta default has been tested.
OpenConnect__Reasoning__Serverless__Enabled=false
OpenConnect__Reasoning__Serverless__Endpoint=
OpenConnect__Reasoning__Serverless__Model=
OpenConnect__Reasoning__Serverless__ApiKey=

# Global spending kill switch; keep at or below $70.00 for testing.
OpenConnect__Pricing__SpendingCap=70.00
# A zero price means unpriced; set explicit rates before enabling paid usage.
OpenConnect__Pricing__InputPer1K=
OpenConnect__Pricing__OutputPer1K=
OpenConnect__Pricing__AudioPerMinute=

# Audio transcription / live audio. Live audio uses a WebSocket URL.
OpenConnect__ASR_MODEL=
OpenConnect__Asr__Language=en
OpenConnect__ASR_WSS=
# Multipart transcription endpoint URL.
OpenConnect__ASR_Transcription__URL=
OpenConnect__ASRMode=DIARIZATION

# TTS internal key: generate a random local secret; do not reuse a provider key.
# TTS use is noncommercial unless separately licensed.
OPENCONNECT_TTS_INTERNAL_KEY=

# Provider-specific testing settings; keys intentionally blank.
OpenConnect__MetaApiKey=
OpenConnect__MetaApiUrl=
OpenConnect__MetaModel=
OpenConnect__ClaudeApiKey=
OpenConnect__ClaudeApiUrl=
OpenConnect__ClaudeModel=
OpenConnect__TranscriptionModel=
OpenConnect__TranscriptionApiUrl=
OpenConnect__VoiceModel=
